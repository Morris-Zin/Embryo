import { AboutSlint, LineEdit, ListView } from "std-widgets.slint";

export struct CatalogChoice {
    item-code: string,
    item-name: string,
    uom: string,
    rate-text: string,
    quantity-text: string,
    barcode: string,
}

export struct VoucherLine {
    item-code: string,
    item-name: string,
    qty-text: string,
    uom: string,
    rate-text: string,
    amount-text: string,
}

export struct InvoiceRow {
    name: string,
    customer: string,
    posting-date: string,
    due-date: string,
    total-text: string,
    status: string,
    customer-width: length,
    name-width: length,
}

global Design {
    out property <color> bg: #f4f6f8;
    out property <color> panel: #ffffff;
    out property <color> text: #17202a;
    out property <color> muted: #667085;
    out property <color> line: #d8dee6;
    out property <color> accent: #146c43;
    out property <color> accent-strong: #0f5132;
    out property <color> accent-soft: #e7f6ee;
    out property <color> focus: #2e90fa;
    out property <color> danger: #b42318;
}

component NavPill inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    border-radius: 20px;
    background: active ? #ffffff : transparent;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: true;

    touch := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: Design.text;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component BrowserSelect inherits Rectangle {
    in property <string> value;
    in property <string> label-text: "";
    in property <bool> use-label-text: false;
    in property <bool> disabled: false;
    background: #ffffff;
    border-color: Design.line;
    border-width: 1px;
    border-radius: 12px;
    accessible-role: combobox;
    accessible-label: use-label-text ? label-text : value;
    accessible-enabled: !disabled;

    Text {
        x: 12px;
        width: root.width - 34px;
        height: root.height;
        text: root.value;
        color: root.disabled ? Design.muted : Design.text;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: root.width - 24px;
        width: 16px;
        height: root.height;
        text: "▾";
        color: Design.muted;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component BrowserButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    opacity: enabled ? 1.0 : 0.55;
    background: primary ? Design.accent : #ffffff;
    border-color: primary ? Design.accent : Design.line;
    border-width: 1px;
    border-radius: 12px;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;

    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: primary ? #ffffff : Design.text;
        font-size: 14px;
        font-weight: primary ? 900 : 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component PrintRadio inherits Rectangle {
    in property <string> text;
    in property <string> value: "";
    in property <bool> checked;
    background: #ffffff;
    border-color: Design.line;
    border-width: 1px;
    border-radius: 20px;
    Rectangle {
        x: 12px;
        y: 13px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 1px;
        border-color: checked ? #2e90fa : #98a2b3;
        background: #ffffff;
        Rectangle {
            x: 1px; y: -12px; width: 13px; height: 40px;
            accessible-role: radio-button;
            accessible-label: root.text;
            accessible-value: root.value;
            accessible-enabled: true;
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: checked ? #2e90fa : transparent;
        }
    }
    Text {
        x: 32px;
        width: root.width - 40px;
        height: root.height;
        text: root.text;
        color: Design.text;
        font-size: 14px;
        vertical-alignment: center;
    }
}

component PanelBox inherits Rectangle {
    background: Design.panel;
    border-color: Design.line;
    border-width: 1px;
    border-radius: 16px;
    clip: false;
    @children
}

component SearchResultRow inherits Rectangle {
    in property <CatalogChoice> item;
    in property <bool> active: false;
    in property <bool> show-rates: true;
    callback chosen(string);
    height: 65.96875px;

    content := Rectangle {
        x: 0px; y: 0px; width: 100%; height: 62.78125px;
        border-radius: 10px;
        background: active || touch.has-hover ? Design.accent-soft : transparent;
        accessible-role: button;
        accessible-label: item.item-code + " " + item.item-name + " Stock " + item.quantity-text + " " + (show-rates ? item.rate-text : "—");
        accessible-enabled: true;

        Rectangle {
            x: 0px; y: 0px; width: 100%; height: 100%;
            accessible-role: list-item;
            accessible-label: item.item-code + " " + item.item-name + " Stock " + item.quantity-text + " " + (show-rates ? item.rate-text : "—");
            accessible-enabled: true;
        }
    }
    touch := TouchArea { height: 62.78125px; clicked => { root.chosen(item.item-code); } }
    Text {
        x: 10px;
        y: 7px;
        width: root.width - 150px;
        text: item.item-code;
        color: Design.text;
        font-size: 14px;
        font-weight: 700;
        overflow: elide;
    }
    Text {
        x: 10px;
        y: 30px;
        width: root.width - 150px;
        text: item.item-name;
        color: Design.muted;
        font-size: 12px;
        overflow: elide;
    }
    Text {
        x: root.width - 132px;
        y: 7px;
        width: 120px;
        text: "Stock " + item.quantity-text;
        color: Design.muted;
        font-size: 13px;
        font-weight: 800;
        horizontal-alignment: right;
    }
    Text {
        x: root.width - 132px;
        y: 30px;
        width: 120px;
        text: show-rates ? item.rate-text : "—";
        color: Design.accent-strong;
        font-size: 13px;
        font-weight: 800;
        horizontal-alignment: right;
    }
}

component VoucherLineRow inherits Rectangle {
    in property <VoucherLine> line;
    callback remove(string);
    callback increase(string);
    callback decrease(string);
    callback quantity-edited(string, string);
    height: 48px;

    Text { x: 14px; width: 300px; height: 48px; text: line.item-name; color: Design.text; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
    Text { x: 14px; y: 28px; width: 300px; text: line.item-code; color: Design.muted; font-size: 11px; overflow: elide; }
    Rectangle {
        x: 313.71875px; y: 9.578125px; width: 40px; height: 40px;
        border-radius: 10px; border-color: Design.line; border-width: 1px; background: #ffffff;
        accessible-role: button; accessible-label: "Decrease quantity"; accessible-enabled: true;
        Text { text: "−"; color: Design.text; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.decrease(line.item-code); } }
    }
    LineEdit {
        x: 353.71875px; y: 9.578125px; width: 72px; height: 40px;
        text: line.qty-text;
        accessible-role: text-input;
        accessible-label: "Quantity";
        horizontal-alignment: center;
        accepted => { root.quantity-edited(line.item-code, self.text); }
    }
    Rectangle {
        x: 425.71875px; y: 9.578125px; width: 40px; height: 40px;
        border-radius: 10px; border-color: Design.line; border-width: 1px; background: #ffffff;
        accessible-role: button; accessible-label: "Increase quantity"; accessible-enabled: true;
        Text { text: "+"; color: Design.text; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.increase(line.item-code); } }
    }
    Text { x: 660px; width: 70px; height: 48px; text: line.uom; color: Design.muted; font-size: 14px; vertical-alignment: center; }
    Text { x: 730px; width: 130px; height: 48px; text: line.rate-text; color: Design.text; font-size: 14px; horizontal-alignment: right; vertical-alignment: center; }
    Text { x: 860px; width: 175px; height: 48px; text: line.amount-text; color: Design.text; font-size: 14px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
    Rectangle {
        x: 1017.046875px; y: 9.578125px; width: 40px; height: 40px;
        border-radius: 10px; border-color: Design.line; border-width: 1px; background: #ffffff;
        accessible-role: button; accessible-label: "Remove line"; accessible-enabled: true;
        Text { text: "×"; color: Design.danger; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.remove(line.item-code); } }
    }
}

component CounterScreen inherits FocusScope {
    in property <bool> sales-mode;
    in property <length> scroll-offset: 0px;
    in property <[CatalogChoice]> search-results;
    in property <[VoucherLine]> voucher-lines;
    in property <bool> search-open;
    in property <string> status-text;
    in property <string> total-qty-text;
    in property <string> subtotal-text;
    in-out property <bool> clear-scan-after-accept;
    callback navigate(int);
    callback search-edited(string);
    callback sales-scan-accepted(string);
    callback choose-item(string);
    callback remove-line(string);
    callback increase-line(string);
    callback decrease-line(string);
    callback line-quantity-edited(string, string);
    callback clear-lines();
    callback submit-print();

    init => { item-search.focus(); }
    key-pressed(event) => {
        if event.text == Key.F2 {
            item-search.focus();
            accept
        } else if event.text == Key.F9 {
            root.submit-print();
            accept
        } else {
            reject
        }
    }

    Rectangle {
        x: 0px; y: 0px - root.scroll-offset; width: 1180px; height: 80px;
        background: #ffffff;
        border-color: Design.line;
        border-width: 1px;
        Text { x: 32px; y: 12px; width: 220px; text: "KHITMEE OPS"; color: Design.accent; font-size: 12px; font-weight: 800; letter-spacing: 1px; }
        Text { x: 32px; y: 31px; width: 350px; text: root.sales-mode ? "Sales Counter" : "Stock Transfer"; color: Design.text; font-size: 29px; font-weight: 750; }
        Rectangle {
            x: 964px; y: 18px; width: 188px; height: 48px;
            border-radius: 24px;
            background: #e9eef3;
            NavPill { x: 9.140625px; y: 7.5px; width: 69.828125px; height: 40px; text: "Sales"; active: root.sales-mode; clicked => { root.navigate(0); } }
            NavPill { x: 86.96875px; y: 7.5px; width: 93.03125px; height: 40px; text: "Transfer"; active: !root.sales-mode; clicked => { root.navigate(1); } }
        }
    }

    PanelBox {
        x: 28px; y: 95px - root.scroll-offset; width: 432px; height: root.sales-mode ? 481px : 457px;
        Text { x: 21px; y: 30px; text: root.sales-mode ? "Sale details" : "Transfer details"; color: Design.text; font-size: 16px; font-weight: 700; }

        Text { x: 21px; y: 67px; text: root.sales-mode ? "Shop warehouse" : "Source warehouse"; color: Design.muted; font-size: 13px; font-weight: 700; }
        BrowserSelect { x: 21px; y: 90.59375px; width: 396.421875px; height: 40px; value: "Dist Hub 1"; label-text: root.sales-mode ? "Shop warehouse" : "Source warehouse"; use-label-text: true; }

        Text { visible: root.sales-mode; x: 21px; y: 144px; text: "Customer"; color: Design.muted; font-size: 13px; font-weight: 700; }
        LineEdit {
            visible: root.sales-mode;
            x: 21px; y: 167.78125px; width: 396.421875px; height: 48px;
            input-type: search;
            placeholder-text: "Filter customers…";
            accessible-label: "Customer Choose customer Load more customers";
            font-size: 17px;
        }
        BrowserSelect { visible: root.sales-mode; x: 21px; y: 221.375px; width: 396.421875px; height: 40px; value: "Choose customer"; label-text: ""; use-label-text: true; }
        BrowserButton { visible: root.sales-mode; x: 21px; y: 266.96875px; width: 396.421875px; height: 40px; text: "Load more customers"; }
        Text { visible: root.sales-mode; x: 21px; y: 320px; text: "Payment mode"; color: Design.muted; font-size: 13px; font-weight: 700; }
        BrowserSelect { visible: root.sales-mode; x: 21px; y: 344.15625px; width: 396.421875px; height: 40px; value: "No payment / credit"; label-text: "Payment mode"; use-label-text: true; }
        Text { visible: root.sales-mode; x: 21px; y: 397px; text: "Print format"; color: Design.muted; font-size: 13px; font-weight: 700; }
        PrintRadio { visible: root.sales-mode; x: 21px; y: 421.34375px; width: 143.0625px; height: 42px; text: "Voucher 80mm"; checked: true; value: "voucher"; }
        PrintRadio { visible: root.sales-mode; x: 174.453125px; y: 421.34375px; width: 107.828125px; height: 42px; text: "Canon A4"; checked: false; value: "a4"; }

        Text { visible: !root.sales-mode; x: 21px; y: 144px; text: "Target warehouse"; color: Design.muted; font-size: 13px; font-weight: 700; }
        BrowserSelect { visible: !root.sales-mode; x: 21px; y: 167.78125px; width: 396.421875px; height: 40px; value: "Choose target warehouse"; label-text: "Target warehouse"; use-label-text: true; }
        Text { visible: !root.sales-mode; x: 21px; y: 221px; text: "Transfer mode"; color: Design.muted; font-size: 13px; font-weight: 700; }
        BrowserSelect { visible: !root.sales-mode; x: 21px; y: 244.96875px; width: 396.421875px; height: 40px; value: "Direct transfer"; label-text: "Transfer mode"; use-label-text: true; }
        Text { visible: !root.sales-mode; x: 21px; y: 298px; text: "Outgoing stock entry"; color: Design.muted; font-size: 13px; font-weight: 700; }
        LineEdit {
            visible: !root.sales-mode;
            x: 21px; y: 322.15625px; width: 396.421875px; height: 40px;
            enabled: false;
            placeholder-text: "Required in receive mode";
            accessible-role: text-input;
            accessible-label: "Outgoing stock entry";
        }
        Text { visible: !root.sales-mode; x: 21px; y: 375px; text: "Print format"; color: Design.muted; font-size: 13px; font-weight: 700; }
        PrintRadio { visible: !root.sales-mode; x: 21px; y: 399.34375px; width: 143.0625px; height: 42px; text: "Voucher 80mm"; checked: true; value: "voucher"; }
        PrintRadio { visible: !root.sales-mode; x: 174.453125px; y: 399.34375px; width: 107.828125px; height: 42px; text: "Canon A4"; checked: false; value: "a4"; }
    }

    PanelBox {
        x: 476px; y: 95px - root.scroll-offset; width: 676px; height: root.sales-mode ? 481px : 457px;
        Text { x: 19px; y: 30px; text: "Scan or search"; color: Design.text; font-size: 16px; font-weight: 700; }
        Text { x: 19px; y: 64px; text: "Barcode / item search"; color: Design.muted; font-size: 13px; font-weight: 700; }
        Rectangle {
            x: 20px; y: 82px; width: 21px; height: 17px;
            border-color: Design.line; border-width: 1px; border-radius: 5px; background: #f8fafc;
            Text { text: "F2"; color: Design.muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
        }
        item-search := LineEdit {
            x: 19.421875px; y: 112.171875px; width: 635.5625px; height: 48px;
            input-type: search;
            placeholder-text: "Scan barcode or type item name…";
            accessible-label: "Barcode / item search F2";
            accessible-expanded: root.search-open;
            font-size: 17px;
            accessible-role: combobox;
            edited => { root.search-edited(self.text); }
            accepted => {
                root.sales-scan-accepted(self.text);
                if root.clear-scan-after-accept { self.text = ""; } else { self.select-all(); }
            }
        }
        Rectangle {
            visible: item-search.has-focus;
            x: 15px; y: 108px; width: 644px; height: 56px;
            border-radius: 14px;
            border-width: 3px;
            border-color: #86b7fe;
            background: transparent;
        }
    }

    PanelBox {
        x: 28px; y: (root.sales-mode ? 592px : 570px) - root.scroll-offset; width: 1124px; height: 96px + root.voucher-lines.length * 48px;
        border-radius: 14px;
        Rectangle { x: 0px; y: 0px; width: 1124px; height: 72px; border-color: Design.line; border-width: 1px; }
        Text { x: 21px; y: 22px; text: "Lines"; color: Design.text; font-size: 16px; font-weight: 700; }
        BrowserButton { x: 1036.34375px; y: 13.140625px; width: 66.640625px; height: 40px; text: "Clear"; clicked => { root.clear-lines(); } }
        Rectangle {
            x: 5px; y: 66.9375px; width: 1113.984375px;
            accessible-role: region;
            accessible-label: root.sales-mode ? "Sale lines" : "Transfer lines";
            height: 34.59375px + root.voucher-lines.length * 61.09375px;
        }
        Rectangle { x: 0px; y: 66px; width: 1124px; height: 36px; background: #f8fafc; }
        Text { x: 15px; y: 75px; width: 300px; text: "ITEM"; color: Design.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; }
        Text { x: 320px; y: 75px; width: 325px; text: "QTY"; color: Design.muted; font-size: 12px; font-weight: 700; horizontal-alignment: center; letter-spacing: 0.5px; }
        Text { x: 660px; y: 75px; width: 70px; text: "UOM"; color: Design.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; }
        Text { x: 730px; y: 75px; width: 130px; text: "RATE"; color: Design.muted; font-size: 12px; font-weight: 700; horizontal-alignment: right; letter-spacing: 0.5px; }
        Text { x: 860px; y: 75px; width: 175px; text: "AMOUNT"; color: Design.muted; font-size: 12px; font-weight: 700; horizontal-alignment: right; letter-spacing: 0.5px; }
        ListView {
            x: 0px; y: 102px; width: 1124px; height: root.voucher-lines.length * 48px;
            for row in root.voucher-lines: VoucherLineRow {
                line: row;
                remove(code) => { root.remove-line(code); }
                increase(code) => { root.increase-line(code); }
                decrease(code) => { root.decrease-line(code); }
                quantity-edited(code, value) => { root.line-quantity-edited(code, value); }
            }
        }
    }

    if root.search-open: Rectangle {
        x: 492px; y: (root.sales-mode ? 566px : 544px) - root.scroll-offset; width: 644px; height: 384px;
        background: #ffffff;
        border-color: Design.line;
        border-width: 1px;
        border-radius: 14px;
        clip: false;
        Rectangle {
            x: 3.421875px; y: -2.0625px; width: 635.5625px; height: 384px;
            accessible-role: list;
            accessible-label: "Item search results";
            accessible-enabled: true;
        }
        Rectangle {
            x: 10.015625px; y: 4.53125px; width: 607.375px; height: 660px;
            for row[index] in root.search-results: SearchResultRow {
                x: 0px; y: index * 65.96875px;
                width: 607.375px;
                item: row;
                active: index == 0;
                show-rates: root.sales-mode;
                chosen(code) => { root.choose-item(code); }
            }
        }
    }


    if root.voucher-lines.length > 0: Rectangle {
        x: 28px; y: 687px; width: 1124px; height: 0px;
    }

    Rectangle {
        x: 0px; y: 688px; width: 1180px; height: 72px;
        background: #ffffff;
        border-color: Design.line;
        border-width: 1px;
        Text { x: 28px; y: 24px; width: 100px; text: "Total qty"; color: Design.text; font-size: 14px; vertical-alignment: center; }
        Text { x: 102px; y: 19px; width: 35px; text: root.total-qty-text; color: Design.text; font-size: 20px; font-weight: 800; vertical-alignment: center; }
        Text { x: 150px; y: 24px; width: 70px; text: root.sales-mode ? "Subtotal" : "Total"; color: Design.text; font-size: 14px; vertical-alignment: center; }
        Text { x: 224px; y: 19px; width: 70px; text: root.subtotal-text; color: Design.text; font-size: 20px; font-weight: 800; vertical-alignment: center; }
        Text {
            x: root.sales-mode ? (root.subtotal-text == "0.00" ? 241.953125px : 253px) : 189.09375px; y: 26px; width: root.sales-mode ? (root.subtotal-text == "0.00" ? 703.234375px : 692.1875px) : 756.09375px; height: 20px;
            text: root.status-text;
            color: Design.muted;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            accessible-live-region: polite;
        }
        BrowserButton { x: 961.1875px; y: 12px; width: 186.8125px; height: 48px; text: "Submit & Print  F9"; primary: true; enabled: root.voucher-lines.length > 0; clicked => { root.submit-print(); } }
    }
}

component InvoiceSkeletonControl inherits Rectangle {
    in property <string> label-text;
    border-width: 0px;
    background: transparent;
    accessible-label: label-text;
    accessible-enabled: true;
    if label-text != "": Text { x: 0px; y: 0px; width: 100%; height: 100%; text: label-text; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
}

component InvoiceGeneratedRow inherits Rectangle {
    in property <InvoiceRow> invoice;
    in property <int> index;
    height: 41px;

    Rectangle {
        x: 311px; y: 190px + index * 41px; width: 14px; height: 14px;
        accessible-role: checkbox; accessible-label: "on"; accessible-value: "on"; accessible-enabled: true;
        background: transparent;
    }

    Rectangle {
        x: 333px; y: 187.59375px + index * 41px; width: invoice.customer-width; height: 18.796875px;
        accessible-role: button; accessible-label: invoice.customer; accessible-enabled: true;
        background: transparent;
    }

    Rectangle {
        x: 538.421875px; y: 189.84375px + index * 41px; width: 74.765625px; height: 17px;
        accessible-role: button; accessible-label: invoice.posting-date; accessible-enabled: true;
        background: transparent;
    }

    Rectangle {
        x: 656.125px; y: 189.84375px + index * 41px; width: invoice.due-date == "2026-11-27" ? 74.765625px : 73.046875px; height: 17px;
        accessible-role: button; accessible-label: invoice.due-date; accessible-enabled: true;
        background: transparent;
    }

    Rectangle {
        x: 773.84375px; y: 186.5px + index * 41px; width: 102.703125px; height: 21px;
        accessible-role: button; accessible-label: "$ " + invoice.total-text; accessible-enabled: true;
        background: transparent;
    }

    Rectangle {
        x: 891.546875px; y: 187.15625px + index * 41px; width: invoice.name-width; height: 19.6875px;
        accessible-role: button; accessible-label: invoice.name; accessible-enabled: true;
        background: transparent;
    }

}

component InvoiceScreen inherits Rectangle {
    in property <[InvoiceRow]> invoice-rows;
    in-out property <string> invoice-filter-text;
    callback invoice-filter-edited(string);
    background: #f4f5f7;

