        x: 296px; y: 62px; width: 107px; height: 28px;
        placeholder-text: "ID";
        font-size: 12px;
        accessible-role: text-input;
        accessible-label: "ID";
        text <=> root.invoice-filter-text;
        edited => { root.invoice-filter-edited(self.text); }
    }
    for row[index] in root.invoice-rows: InvoiceGeneratedRow {
        x: 0px; y: 0px; width: 1180px; invoice: row; index: index;
    }
}

export component AppWindow inherits Window {
    title: "Khitmee Native Counter";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 1180px;
    min-height: 760px;
    background: Design.bg;

    in property <[CatalogChoice]> search-results: [];
    in property <[VoucherLine]> voucher-lines: [];
    in property <[InvoiceRow]> invoice-rows: [];
    in-out property <string> status-text: "Ready. Scan a barcode or press F2 to search.";
    in-out property <string> total-qty-text: "0";
    in-out property <string> subtotal-text: "0.00";
    in-out property <int> current-screen: 0;
    in-out property <string> fixture-note: "Fixture catalog: deterministic qualification data";
    in-out property <string> invoice-filter-text: "";
    in-out property <bool> clear-scan-after-accept: false;
    in-out property <bool> search-open: false;

    callback search-edited(string);
    callback sales-scan-accepted(string);
    callback choose-item(string);
    callback remove-line(string);
    callback increase-line(string);
    callback decrease-line(string);
    callback line-quantity-edited(string, string);
    callback clear-lines();
    callback submit-print();
    callback invoice-filter-edited(string);

    if current-screen == 0 || current-screen == 4: CounterScreen {
        width: 1180px; height: 760px;
        sales-mode: true;
        scroll-offset: current-screen == 4 ? 43px : 0px;
        search-results: root.search-results;
        voucher-lines: root.voucher-lines;
        search-open: root.search-open;
        status-text: root.status-text;
        total-qty-text: root.total-qty-text;
        subtotal-text: root.subtotal-text;
        clear-scan-after-accept <=> root.clear-scan-after-accept;
        navigate(screen) => { current-screen = screen; }
        search-edited(text) => { root.search-edited(text); }
        sales-scan-accepted(text) => { root.sales-scan-accepted(text); }
        choose-item(code) => { root.choose-item(code); }
        remove-line(code) => { root.remove-line(code); }
        clear-lines => { root.clear-lines(); }
        submit-print => { root.submit-print(); }
    }

    if current-screen == 1: CounterScreen {
        width: 1180px; height: 760px;
        sales-mode: false;
        search-results: root.search-results;
        voucher-lines: root.voucher-lines;
        search-open: root.search-open;
        status-text: root.status-text;
        total-qty-text: root.total-qty-text;
        subtotal-text: root.subtotal-text;
        clear-scan-after-accept <=> root.clear-scan-after-accept;
        navigate(screen) => { current-screen = screen; }
        search-edited(text) => { root.search-edited(text); }
        sales-scan-accepted(text) => { root.sales-scan-accepted(text); }
        choose-item(code) => { root.choose-item(code); }
        remove-line(code) => { root.remove-line(code); }
        clear-lines => { root.clear-lines(); }
        submit-print => { root.submit-print(); }
    }

    if current-screen == 2: InvoiceScreen {
        width: 1180px; height: 760px;
        invoice-rows: root.invoice-rows;
        invoice-filter-text <=> root.invoice-filter-text;
        invoice-filter-edited(text) => { root.invoice-filter-edited(text); }
    }

    if current-screen == 3: Rectangle {
        background: Design.bg;
        x: 390px; y: 250px; width: 400px; height: 240px;
        Text { x: 0px; y: 0px; width: 400px; text: root.fixture-note; color: Design.muted; wrap: word-wrap; }
        AboutSlint { x: 0px; y: 120px; width: 180px; height: 80px; }
    }
}
