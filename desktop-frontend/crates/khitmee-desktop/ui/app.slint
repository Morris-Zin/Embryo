        accessible-role: button; accessible-label: ""; accessible-enabled: true;
        background: transparent;
        if "" != "": Text { width: 100%; height: 100%; text: ""; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        x: 446px; y: 106px; width: 140px; height: 28px;
        accessible-role: text-input; accessible-label: "Posting Date"; accessible-enabled: true;
        background: transparent;
        if "Posting Date" != "": Text { width: 100%; height: 100%; text: "Posting Date"; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        x: 596px; y: 106px; width: 140px; height: 28px;
        accessible-role: combobox; accessible-label: "Draft Return Credit Note Issued Submitted Paid Partly Paid Unpaid Unpaid and Discounted Partly Paid and Discounted Overdue and Discounted Overdue Cancelled Internal Transfer"; accessible-enabled: true;
        background: transparent;
        if "Draft Return Credit Note Issued Submitted Paid Partly Paid Unpaid Unpaid and Discounted Partly Paid and Discounted Overdue and Discounted Overdue Cancelled Internal Transfer" != "": Text { width: 100%; height: 100%; text: "Draft Return Credit Note Issued Submitted Paid Partly Paid Unpaid Unpaid and Discounted Partly Paid and Discounted Overdue and Discounted Overdue Cancelled Internal Transfer"; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        x: 924.078125px; y: 62px; width: 75.171875px; height: 28px;
        visible: root.invoice-filter-text == "";
        accessible-role: button; accessible-label: "Filter"; accessible-enabled: true;
        background: transparent;
        if "Filter" != "": Text { width: 100%; height: 100%; text: "Filter"; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        x: 1009.25px; y: 62px; width: 28px; height: 28px;
        accessible-role: button; accessible-label: root.invoice-sort-label; accessible-enabled: true;
        background: transparent;
        TouchArea { width: 100%; height: 100%; clicked => { root.invoice-sort-toggle(); } }
        Text { width: 100%; height: 100%; text: root.invoice-sort-label; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        x: 1037.25px; y: 62px; width: 117.75px; height: 28px;
        accessible-role: button; accessible-label: "ID"; accessible-enabled: true;
        background: transparent;
        Text { width: 100%; height: 100%; text: "ID"; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        x: 311px; y: 154.5px; width: 14px; height: 14px;
        accessible-role: checkbox; accessible-label: "on"; accessible-value: "on"; accessible-enabled: true;
        background: transparent;
        if "on" != "": Text { width: 100%; height: 100%; text: "on"; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        x: 296px; y: parent.height - 35px; width: 80px; height: 28px;
        accessible-role: radio-group; accessible-label: "Page Size"; accessible-enabled: true;
        background: transparent;
        if "Page Size" != "": Text { width: 100%; height: 100%; text: "Page Size"; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        x: 386px; y: parent.height - 34px; width: 32px; height: 26px;
        accessible-role: radio-button; accessible-label: "20"; accessible-enabled: true;
        background: transparent;
        if "20" != "": Text { width: 100%; height: 100%; text: "20"; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        x: 424px; y: parent.height - 34px; width: 38px; height: 26px;
        accessible-role: radio-button; accessible-label: "100"; accessible-enabled: true;
        background: transparent;
        Text { width: 100%; height: 100%; text: "100"; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }
    Rectangle {
        x: 468px; y: parent.height - 34px; width: 41px; height: 26px;
        accessible-role: radio-button; accessible-label: "500"; accessible-enabled: true;
        background: transparent;
        if "500" != "": Text { width: 100%; height: 100%; text: "500"; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        x: 515px; y: parent.height - 34px; width: 49px; height: 26px;
        accessible-role: radio-button; accessible-label: "2500"; accessible-enabled: true;
        background: transparent;
        if "2500" != "": Text { width: 100%; height: 100%; text: "2500"; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        x: parent.width - 114px; y: parent.height - 35px; width: 88.625px; height: 28px;
        visible: root.invoice-rows.length >= 20;
        accessible-role: button; accessible-label: "Load More"; accessible-enabled: true;
        background: transparent;
        TouchArea { width: 100%; height: 100%; clicked => { root.invoice-load-more(); } }
        if "Load More" != "": Text { width: 100%; height: 100%; text: "Load More"; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        x: 868.078125px; y: 62px; width: 103.171875px; height: 28px;
        visible: root.invoice-filter-text != "";
        accessible-role: button; accessible-label: "Filter 1"; accessible-enabled: true;
        background: transparent;
        Text { width: 100%; height: 100%; text: "Filter 1"; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
    }
    Rectangle {
        x: 971.25px; y: 62px; width: 28px; height: 28px;
        visible: root.invoice-filter-text != "";
        accessible-role: button; accessible-label: "Clear all filters"; accessible-enabled: true;
        background: transparent;
    }
    invoice-filter := LineEdit {
        x: 296px; y: 62px; width: 230px; height: 28px;
        placeholder-text: "ID";
        font-size: 12px;
        accessible-role: text-input;
        accessible-label: "ID";
        text <=> root.invoice-filter-text;
        edited => { root.invoice-filter-edited(self.text); }
    }
    Text { x: 590px; y: parent.height - 35px; width: 180px; height: 28px; text: root.invoice-count-text; accessible-label: root.invoice-count-text; color: Design.muted; font-size: 11px; vertical-alignment: center; }
}

component DetailFieldBox inherits Rectangle {
    in property <DetailField> field;
    in property <length> column-width;
    callback edited(string, string);
    x: 264px + field.column * (root.column-width + 12px);
    y: 112px + field.row * 58px;
    width: root.column-width;
    height: 48px;
    accessible-role: text;
    accessible-label: "\{field.label}: \{field.value}";
    accessible-enabled: field.editable;

    Text {
        x: 0px; y: 0px; width: parent.width; height: 16px;
        text: field.label; color: Design.muted; font-size: 11px; overflow: elide;
    }
    Rectangle {
        x: 0px; y: 19px; width: parent.width; height: 28px;
        background: #f8fafc; border-color: #e4e7ec; border-width: 1px; border-radius: 6px;
        if !field.editable: Text {
            x: 9px; width: parent.width - 18px; height: parent.height;
            text: field.value; color: Design.text; font-size: 12px;
            font-weight: field.emphasized ? 750 : 500;
            vertical-alignment: center; overflow: elide;
        }
        if field.editable: LineEdit {
            x: 3px; y: 1px; width: parent.width - 6px; height: parent.height - 2px;
            text: field.value;
            accessible-role: text-input;
            accessible-label: field.label;
            accessible-enabled: true;
            font-size: 12px;
            edited => { root.edited(field.label, self.text); }
        }
    }
}

component DetailNavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    height: 28px;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: true;
    Text {
        x: 12px; width: parent.width - 16px; height: parent.height;
        text: parent.text; color: active ? #175cd3 : #344054;
        font-size: 12px; font-weight: active ? 700 : 500; vertical-alignment: center;
    }
}

component InvoiceDetailScreen inherits Rectangle {
    in property <string> detail-title: "Sales Invoice";
    in property <string> detail-name: "";
    in property <string> detail-customer-title: "";
    in property <string> detail-status: "";
    in property <[DetailField]> detail-fields: [];
    in property <[InvoiceDetailItem]> detail-items: [];
    in property <bool> detail-dirty: false;
    in property <string> detail-error-text: "";
    in property <string> detail-validation-text: "";
    in property <string> detail-validation-title: "";
    callback detail-validation-close();
    callback back-to-list();
    callback detail-field-edited(string, string);
    callback detail-save();
    callback detail-submit();
    callback detail-item-open(int);
    callback detail-item-qty-edited(int, string);
    callback detail-item-rate-edited(int, string);
    callback detail-item-code-edited(int, string);
    callback detail-item-add();
    callback detail-item-select(int);
    callback detail-item-delete();
    in property <int> detail-editing-index: -1;
    in property <bool> detail-item-selected: false;
    background: #f4f5f7;

    property <length> content-x: 240px;
    property <length> content-width: root.width - root.content-x;
    property <length> column-width: (root.content-width - 88px) / 3;
    property <length> items-top: 410px;
    property <length> detail-content-height: 535px + root.detail-items.length * 38px + (root.detail-editing-index >= 0 ? 48px : 0px);
    property <string> display-status: root.detail-dirty ? "Not Saved" : root.detail-status;

    Rectangle { x: 0px; y: 0px; width: 57px; height: parent.height; background: #ffffff; border-color: #e4e7ec; border-width: 1px; }
    Rectangle { x: 57px; y: 0px; width: 183px; height: parent.height; background: #f8fafc; border-color: #e4e7ec; border-width: 1px; }
    Text { x: 69px; y: 9px; width: 150px; height: 28px; text: "Accounts"; color: Design.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
    DetailNavItem { x: 61px; y: 48px; width: 171px; text: "Home"; }
    DetailNavItem { x: 61px; y: 78px; width: 171px; text: "Dashboard"; }
    DetailNavItem { x: 61px; y: 108px; width: 171px; text: "Chart of Accounts"; }
    DetailNavItem { x: 61px; y: 138px; width: 171px; text: "Sales Invoice"; active: true; }
    DetailNavItem { x: 61px; y: 168px; width: 171px; text: "Purchase Invoice"; }
    DetailNavItem { x: 61px; y: 198px; width: 171px; text: "Payment Entry"; }
    DetailNavItem { x: 61px; y: 228px; width: 171px; text: "Journal Entry"; }

    Rectangle { x: root.content-x; y: 0px; width: root.content-width; height: parent.height; background: #ffffff; }
    Text { x: root.content-x + 20px; y: 10px; width: 170px; height: 28px; text: root.detail-title; color: Design.text; font-size: 16px; font-weight: 700; vertical-alignment: center; accessible-label: root.detail-title; }
    Text { x: root.content-x + 20px; y: 39px; width: 280px; height: 24px; text: root.detail-customer-title; color: Design.text; font-size: 15px; font-weight: 650; vertical-alignment: center; accessible-label: root.detail-customer-title; }
    Rectangle {
        x: root.content-x + 20px; y: 66px; width: 78px; height: 22px;
        border-radius: 11px; background: #fff1f3; border-color: #fecdd3; border-width: 1px;
        accessible-role: text; accessible-label: "Status: \{root.display-status}";
        Text { width: parent.width; height: parent.height; text: root.display-status; color: #c01048; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: root.content-x + 107px; y: 66px; width: 190px; height: 22px; text: root.detail-name; color: Design.muted; font-size: 11px; vertical-alignment: center; accessible-label: root.detail-name; }
    BrowserButton { x: root.content-x + root.content-width - 244px; y: 13px; width: 68px; height: 32px; text: "View"; visible: root.detail-error-text == "" && root.detail-status != "Draft"; }
    BrowserButton { x: root.content-x + root.content-width - 422px; y: 13px; width: 86px; height: 32px; text: "Create"; visible: root.detail-error-text == ""; }
    BrowserButton { x: root.content-x + root.content-width - 330px; y: 13px; width: 86px; height: 32px; text: "Preview"; visible: root.detail-error-text == "" && root.detail-status == "Draft"; }
    BrowserButton { x: root.content-x + root.content-width - 238px; y: 13px; width: 128px; height: 32px; text: "Get Items From"; visible: root.detail-error-text == "" && root.detail-status == "Draft"; }
    BrowserButton { x: root.content-x + root.content-width - 92px; y: 13px; width: 72px; height: 32px; text: "Save"; visible: root.detail-error-text == "" && root.detail-status == "Draft" && root.detail-dirty; primary: true; clicked => { root.detail-save(); } }
    BrowserButton { x: root.content-x + root.content-width - 92px; y: 13px; width: 72px; height: 32px; text: "Submit"; visible: root.detail-error-text == "" && root.detail-status == "Draft" && !root.detail-dirty; primary: true; clicked => { root.detail-submit(); } }
    BrowserButton { x: root.content-x + root.content-width - 92px; y: 13px; width: 72px; height: 32px; text: "Cancel"; visible: root.detail-error-text == "" && root.detail-status != "Draft"; }
    Rectangle {
        x: root.content-x + root.content-width - 318px; y: 13px; width: 66px; height: 32px;
        border-radius: 8px; accessible-role: button; accessible-label: "Back to Sales Invoice list"; accessible-enabled: true;
        touch := TouchArea { clicked => { root.back-to-list(); } }
        Text { width: parent.width; height: parent.height; text: "Back"; color: Design.text; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }

    Rectangle { x: root.content-x + 18px; y: 91px; width: root.content-width - 36px; height: 34px; background: #f8fafc; border-color: #e4e7ec; border-width: 1px; border-radius: 7px; }
    for tab[index] in ["Details", "Payments", "Address & Contact", "Terms", "More Info", "Connections"]: Text {
        x: root.content-x + 32px + index * 104px; y: 91px; width: 96px; height: 34px;
        text: tab; color: index == 0 ? #175cd3 : #475467; font-size: 12px; font-weight: index == 0 ? 700 : 500;
        vertical-alignment: center; accessible-label: tab;
    }

    if root.detail-error-text != "": Rectangle {
        x: root.content-x + 20px; y: 126px; width: root.content-width - 40px; height: parent.height - 146px;
        background: #ffffff; border-color: #e4e7ec; border-width: 1px;
        Text { width: parent.width; height: 160px; text: root.detail-error-text; accessible-label: root.detail-error-text; color: Design.text; font-size: 16px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.detail-validation-text != "": Rectangle {
        x: root.content-x + (root.content-width - 430px) / 2; y: 190px; width: 430px; height: 170px;
        background: #ffffff; border-color: #d0d5dd; border-width: 1px; border-radius: 8px;
        accessible-role: text; accessible-label: root.detail-validation-title;
        Text { x: 20px; y: 14px; width: parent.width - 40px; height: 24px; text: root.detail-validation-title; accessible-label: root.detail-validation-title; color: Design.text; font-size: 15px; font-weight: 750; vertical-alignment: center; }
        Text { x: 20px; y: 45px; width: parent.width - 40px; height: 75px; text: root.detail-validation-text; accessible-label: root.detail-validation-text; color: Design.text; font-size: 12px; vertical-alignment: top; wrap: word-wrap; }
        BrowserButton { x: parent.width - 82px; y: parent.height - 43px; width: 62px; height: 30px; text: "OK"; primary: true; clicked => { root.detail-validation-close(); } }
    }
    Flickable {
        visible: root.detail-error-text == "";
        x: root.content-x; y: 126px; width: root.content-width; height: parent.height - 126px;
        content-width: root.content-width;
        content-height: root.detail-content-height;
        Rectangle { x: 0px; y: 0px; width: root.content-width; height: root.detail-content-height; background: #ffffff; }

        for field in root.detail-fields: DetailFieldBox {
            field: field;
            column-width: root.column-width;
            x: 20px + field.column * (root.column-width + 12px);
            y: 12px + field.row * 58px;
            edited(label, value) => { root.detail-field-edited(label, value); }
        }

        Text { x: 20px; y: 303px; width: 180px; height: 24px; text: "Items"; color: Design.text; font-size: 13px; font-weight: 700; vertical-alignment: center; accessible-label: "Items"; }
        Rectangle { x: 20px; y: 331px; width: root.content-width - 40px; height: 34px; background: #f8fafc; border-color: #e4e7ec; border-width: 1px; }
        Text { x: 28px; y: 331px; width: 34px; height: 34px; text: "No."; color: Design.muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
        Text { x: 70px; y: 331px; width: root.column-width + 70px; height: 34px; text: "Item"; color: Design.muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
        Text { x: root.content-width - 430px; y: 331px; width: 70px; height: 34px; text: "Quantity"; color: Design.muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
        Text { x: root.content-width - 350px; y: 331px; width: 88px; height: 34px; text: "Rate (USD)"; color: Design.muted; font-size: 11px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: root.content-width - 252px; y: 331px; width: 96px; height: 34px; text: "Amount (USD)"; color: Design.muted; font-size: 11px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: root.content-width - 146px; y: 331px; width: 120px; height: 34px; text: "Warehouse"; color: Design.muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }

        for item[index] in root.detail-items: Rectangle {
            x: 20px; y: 365px + index * 38px + (root.detail-editing-index >= 0 && index > root.detail-editing-index ? 48px : 0px); width: root.content-width - 40px; height: root.detail-editing-index == index ? 86px : 38px;
            background: #ffffff; border-color: #eef2f6; border-width: 1px;
            accessible-role: list-item;
            accessible-label: "\{item.index-text} \{item.item-text} \{item.qty-text} \{item.rate-text} \{item.amount-text} \{item.warehouse}";
            TouchArea { enabled: item.editable && root.detail-editing-index != index; clicked => { root.detail-item-open(index); } }
            Rectangle {
                x: 30px; y: root.detail-editing-index == index ? 12px : 11px; width: 15px; height: 15px;
                background: item.selected ? Design.accent : #ffffff; border-color: item.selected ? Design.accent : Design.line; border-width: 1px; border-radius: 3px;
                accessible-role: button; accessible-label: "Select row \{item.index-text}"; accessible-enabled: item.editable;
                TouchArea { enabled: item.editable; clicked => { root.detail-item-select(index); } }
                if item.selected: Text { width: parent.width; height: parent.height; text: "✓"; color: #ffffff; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
            }
            if root.detail-editing-index != index: Rectangle {
                width: parent.width; height: parent.height;
                Text { x: 8px; width: 30px; height: parent.height; text: item.index-text; color: Design.muted; font-size: 11px; vertical-alignment: center; }
                Text { x: 50px; width: root.column-width + 78px; height: parent.height; text: item.item-text; color: #175cd3; font-size: 11px; vertical-alignment: center; overflow: elide; }
                Text { x: root.content-width - 430px; width: 70px; height: parent.height; text: item.qty-text; color: Design.text; font-size: 11px; vertical-alignment: center; }
                Text { x: root.content-width - 350px; width: 88px; height: parent.height; text: item.rate-text; color: Design.text; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                Text { x: root.content-width - 252px; width: 96px; height: parent.height; text: item.amount-text; color: Design.text; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                Text { x: root.content-width - 146px; width: 120px; height: parent.height; text: item.warehouse; color: Design.text; font-size: 11px; vertical-alignment: center; overflow: elide; }
            }
            if root.detail-editing-index == index: Rectangle {
                width: parent.width; height: parent.height;
                Text { x: 8px; y: 7px; width: 30px; height: 24px; text: item.index-text; color: Design.muted; font-size: 11px; vertical-alignment: center; }
                LineEdit { x: 50px; y: 7px; width: root.column-width + 78px; height: 30px; text: item.item-code; accessible-role: text-input; accessible-label: "Item code"; font-size: 11px; edited => { root.detail-item-code-edited(index, self.text); } }
                qty-input := LineEdit { x: root.content-width - 430px; y: 7px; width: 70px; height: 30px; text: item.qty-value; accessible-role: text-input; accessible-label: "Item quantity"; font-size: 11px; edited => { root.detail-item-qty-edited(index, self.text); } }
                TouchArea { x: root.content-width - 430px; y: 7px; width: 70px; height: 30px; clicked => { qty-input.focus(); qty-input.select-all(); } }
                rate-input := LineEdit { x: root.content-width - 350px; y: 7px; width: 88px; height: 30px; text: item.rate-value; accessible-role: text-input; accessible-label: "Item rate"; font-size: 11px; edited => { root.detail-item-rate-edited(index, self.text); } }
                TouchArea { x: root.content-width - 350px; y: 7px; width: 88px; height: 30px; clicked => { rate-input.focus(); rate-input.select-all(); } }
                LineEdit { x: root.content-width - 252px; y: 7px; width: 96px; height: 30px; text: item.amount-value; accessible-role: text-input; accessible-label: "Item amount"; enabled: false; font-size: 11px; }
                LineEdit { x: root.content-width - 146px; y: 7px; width: 120px; height: 30px; text: item.warehouse; accessible-role: text-input; accessible-label: "Item warehouse"; font-size: 11px; }
                Text { x: 50px; y: 45px; width: 260px; height: 28px; text: "item_code    qty    rate    amount    warehouse"; color: Design.muted; font-size: 10px; vertical-alignment: center; }
            }
        }

        if root.detail-status == "Draft" && root.detail-error-text == "": Rectangle {
            x: 20px; y: 373px + root.detail-items.length * 38px + (root.detail-editing-index >= 0 ? 48px : 0px); width: root.content-width - 40px; height: 42px;
            BrowserButton { x: 0px; y: 0px; width: 86px; height: 30px; text: "Add row"; visible: !root.detail-item-selected; clicked => { root.detail-item-add(); } }
            BrowserButton { x: 94px; y: 0px; width: 112px; height: 30px; text: "Add multiple"; visible: !root.detail-item-selected; enabled: false; }
            BrowserButton { x: 0px; y: 0px; width: 100px; height: 30px; text: "Delete row"; visible: root.detail-item-selected; clicked => { root.detail-item-delete(); } }
            BrowserButton { x: 108px; y: 0px; width: 86px; height: 30px; text: "Edit row"; visible: root.detail-item-selected; enabled: false; }
            BrowserButton { x: 202px; y: 0px; width: 118px; height: 30px; text: "Duplicate row"; visible: root.detail-item-selected; enabled: false; }
            BrowserButton { x: 214px; y: 0px; width: 78px; height: 30px; text: "Upload"; visible: !root.detail-item-selected; enabled: false; }
            BrowserButton { x: 328px; y: 0px; width: 78px; height: 30px; text: "Upload"; visible: root.detail-item-selected; enabled: false; }
        }
    }
}

export component AppWindow inherits Window {
    title: "Khitmee Native Counter";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 1180px;
    min-height: 760px;
    background: Design.bg;

    in property <[CatalogChoice]> search-results: [];
    in property <[VoucherLine]> voucher-lines: [];
    in property <[InvoiceRow]> invoice-rows: [];
    in property <[DetailField]> invoice-detail-fields: [];
    in property <[InvoiceDetailItem]> invoice-detail-items: [];
    in property <bool> invoice-detail-dirty: false;
    in property <bool> invoice-detail-item-selected: false;
    in property <string> invoice-detail-error-text: "";
    in property <string> invoice-detail-validation-text: "";
    in property <string> invoice-detail-validation-title: "";
    in property <int> invoice-detail-editing-index: -1;
    in property <string> invoice-detail-title: "Sales Invoice";
    in property <string> invoice-detail-name: "";
    in property <string> invoice-detail-customer-title: "";
    in property <string> invoice-detail-status: "";
    in property <[string]> warehouse-options: [];
    in property <[string]> customer-options: [];
    in property <[string]> payment-options: [];
    in property <[string]> target-warehouse-options: [];
    in property <[string]> transfer-mode-options: [];
    in property <bool> outgoing-entry-enabled: false;
    in-out property <string> status-text: "Ready. Scan a barcode or press F2 to search.";
    in-out property <string> total-qty-text: "0";
    in-out property <string> subtotal-text: "0.00";
    in-out property <int> current-screen: 0;
    in-out property <string> fixture-note: "Fixture catalog: deterministic qualification data";
    in-out property <string> invoice-filter-text: "";
    in-out property <string> invoice-count-text: "";
    in-out property <string> invoice-error-text: "";
    in property <string> invoice-sort-label: "descending";
    in-out property <bool> clear-scan-after-accept: false;
    in-out property <bool> search-open: false;
    in-out property <int> active-search-index: 0;

    callback warehouse-selected(string);
    callback customer-selected(string);
    callback payment-selected(string);
    callback target-warehouse-selected(string);
    callback transfer-mode-selected(string);
    callback outgoing-stock-entry-edited(string);
    callback search-edited(string);
    callback sales-scan-accepted(string);
    callback choose-item(string);
    callback remove-line(string);
    callback increase-line(string);
    callback decrease-line(string);
    callback line-quantity-edited(string, string);
    callback clear-lines();
    callback submit-print();
    callback invoice-filter-edited(string);
    callback invoice-load-more();
    callback invoice-sort-toggle();
    callback invoice-open(string);
    callback invoice-detail-field-edited(string, string);
    callback invoice-detail-save();
    callback invoice-detail-submit();
    callback invoice-detail-item-open(int);
    callback invoice-detail-item-qty-edited(int, string);
    callback invoice-detail-item-rate-edited(int, string);
    callback invoice-detail-item-code-edited(int, string);
    callback invoice-detail-item-add();
    callback invoice-detail-item-select(int);
    callback invoice-detail-item-delete();
    callback invoice-detail-validation-close();

    if current-screen == 0 || current-screen == 4: CounterScreen {
        width: parent.width; height: parent.height;
        sales-mode: true;
        warehouse-options: root.warehouse-options;
        customer-options: root.customer-options;
        payment-options: root.payment-options;
        initial-scroll-offset: current-screen == 4 ? 43px : 0px;
        search-results: root.search-results;
        voucher-lines: root.voucher-lines;
        search-open <=> root.search-open;
        active-search-index <=> root.active-search-index;
        status-text: root.status-text;
        total-qty-text: root.total-qty-text;
        subtotal-text: root.subtotal-text;
        clear-scan-after-accept <=> root.clear-scan-after-accept;
        navigate(screen) => { current-screen = screen; }
        warehouse-selected(value) => { root.warehouse-selected(value); }
        customer-selected(value) => { root.customer-selected(value); }
        payment-selected(value) => { root.payment-selected(value); }
        search-edited(text) => { root.search-edited(text); }
        sales-scan-accepted(text) => { root.sales-scan-accepted(text); }
        choose-item(code) => { root.choose-item(code); }
        remove-line(code) => { root.remove-line(code); }
        increase-line(code) => { root.increase-line(code); }
        decrease-line(code) => { root.decrease-line(code); }
        line-quantity-edited(code, value) => { root.line-quantity-edited(code, value); }
        clear-lines => { root.clear-lines(); }
        submit-print => { root.submit-print(); }
    }

    if current-screen == 1: CounterScreen {
        width: parent.width; height: parent.height;
        sales-mode: false;
        warehouse-options: root.warehouse-options;
        customer-options: root.customer-options;
        payment-options: root.payment-options;
        target-warehouse-options: root.target-warehouse-options;
        transfer-mode-options: root.transfer-mode-options;
        search-results: root.search-results;
        voucher-lines: root.voucher-lines;
        search-open <=> root.search-open;
        active-search-index <=> root.active-search-index;
        status-text: root.status-text;
        total-qty-text: root.total-qty-text;
        subtotal-text: root.subtotal-text;
        clear-scan-after-accept <=> root.clear-scan-after-accept;
        navigate(screen) => { current-screen = screen; }
        warehouse-selected(value) => { root.warehouse-selected(value); }
        customer-selected(value) => { root.customer-selected(value); }
        payment-selected(value) => { root.payment-selected(value); }
        target-warehouse-selected(value) => { root.target-warehouse-selected(value); }
        transfer-mode-selected(value) => { root.transfer-mode-selected(value); }
        outgoing-stock-entry-edited(text) => { root.outgoing-stock-entry-edited(text); }
        search-edited(text) => { root.search-edited(text); }
        sales-scan-accepted(text) => { root.sales-scan-accepted(text); }
        choose-item(code) => { root.choose-item(code); }
        remove-line(code) => { root.remove-line(code); }
        increase-line(code) => { root.increase-line(code); }
        decrease-line(code) => { root.decrease-line(code); }
        line-quantity-edited(code, value) => { root.line-quantity-edited(code, value); }
        clear-lines => { root.clear-lines(); }
        submit-print => { root.submit-print(); }
    }

    if current-screen == 2: InvoiceScreen {
        width: parent.width; height: parent.height;
        invoice-rows: root.invoice-rows;
        invoice-filter-text <=> root.invoice-filter-text;
        invoice-count-text: root.invoice-count-text;
        invoice-error-text: root.invoice-error-text;
        invoice-sort-label: root.invoice-sort-label;
        invoice-filter-edited(text) => { root.invoice-filter-edited(text); }
        invoice-load-more => { root.invoice-load-more(); }
        invoice-sort-toggle => { root.invoice-sort-toggle(); }
        invoice-open(name) => { root.invoice-open(name); }
    }

    if current-screen == 3: InvoiceDetailScreen {
        width: parent.width; height: parent.height;
        detail-title: root.invoice-detail-title;
        detail-name: root.invoice-detail-name;
        detail-customer-title: root.invoice-detail-customer-title;
        detail-status: root.invoice-detail-status;
        detail-fields: root.invoice-detail-fields;
        detail-items: root.invoice-detail-items;
        detail-dirty: root.invoice-detail-dirty;
        detail-error-text: root.invoice-detail-error-text;
        detail-validation-text: root.invoice-detail-validation-text;
        detail-validation-title: root.invoice-detail-validation-title;
        detail-validation-close => { root.invoice-detail-validation-close(); }
        detail-editing-index: root.invoice-detail-editing-index;
        detail-item-selected: root.invoice-detail-item-selected;
        back-to-list => { current-screen = 2; }
        detail-field-edited(label, value) => { root.invoice-detail-field-edited(label, value); }
        detail-save => { root.invoice-detail-save(); }
        detail-submit => { root.invoice-detail-submit(); }
        detail-item-open(index) => { root.invoice-detail-item-open(index); }
        detail-item-qty-edited(index, value) => { root.invoice-detail-item-qty-edited(index, value); }
        detail-item-rate-edited(index, value) => { root.invoice-detail-item-rate-edited(index, value); }
        detail-item-code-edited(index, value) => { root.invoice-detail-item-code-edited(index, value); }
        detail-item-add => { root.invoice-detail-item-add(); }
        detail-item-select(index) => { root.invoice-detail-item-select(index); }
        detail-item-delete => { root.invoice-detail-item-delete(); }
    }
}
