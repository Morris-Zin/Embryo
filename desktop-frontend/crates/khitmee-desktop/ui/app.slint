import { AboutSlint, ComboBox, LineEdit, ListView } from "std-widgets.slint";

export struct CatalogChoice {
    item-code: string,
    item-name: string,
    uom: string,
    rate-text: string,
    quantity-text: string,
    barcode: string,
}

export struct VoucherLine {
    item-code: string,
    item-name: string,
    qty-text: string,
    uom: string,
    rate-text: string,
    amount-text: string,
}

export struct InvoiceRow {
    name: string,
    customer: string,
    posting-date: string,
    due-date: string,
    total-text: string,
    status: string,
    customer-width: length,
    name-width: length,
}

export struct DetailField {
    label: string,
    value: string,
    column: int,
    row: int,
    emphasized: bool,
    editable: bool,
}

export struct InvoiceDetailItem {
    index-text: string,
    item-text: string,
    qty-text: string,
    rate-text: string,
    amount-text: string,
    warehouse: string,
    editable: bool,
    item-code: string,
    qty-value: string,
    rate-value: string,
    amount-value: string,
    selected: bool,
}

global Design {
    out property <color> bg: #f4f6f8;
    out property <color> panel: #ffffff;
    out property <color> text: #17202a;
    out property <color> muted: #667085;
    out property <color> line: #d8dee6;
    out property <color> accent: #146c43;
    out property <color> accent-strong: #0f5132;
    out property <color> accent-soft: #e7f6ee;
    out property <color> focus: #2e90fa;
    out property <color> danger: #b42318;
}

component NavPill inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    border-radius: 20px;
    background: active ? #ffffff : transparent;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: true;

    touch := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: Design.text;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component BrowserSelect inherits Rectangle {
    in property <string> value;
    in property <string> label-text: "";
    in property <bool> use-label-text: false;
    in property <bool> disabled: false;
    callback clicked();
    background: #ffffff;
    border-color: Design.line;
    border-width: 1px;
    border-radius: 12px;
    accessible-role: combobox;
    accessible-label: use-label-text ? label-text : value;
    accessible-enabled: !disabled;

    Text {
        x: 12px;
        width: root.width - 34px;
        height: root.height;
        text: root.value;
        color: root.disabled ? Design.muted : Design.text;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: root.width - 24px;
        width: 16px;
        height: root.height;
        text: "▾";
        color: Design.muted;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component BrowserButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    opacity: enabled ? 1.0 : 0.55;
    background: primary ? Design.accent : #ffffff;
    border-color: primary ? Design.accent : Design.line;
    border-width: 1px;
    border-radius: 12px;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;

    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: primary ? #ffffff : Design.text;
        font-size: 14px;
        font-weight: primary ? 900 : 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component PrintRadio inherits Rectangle {
    in property <string> text;
    in property <string> value: "";
    in property <bool> checked;
    background: #ffffff;
    border-color: Design.line;
    border-width: 1px;
    border-radius: 20px;
    Rectangle {
        x: 12px;
        y: 13px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 1px;
        border-color: checked ? #2e90fa : #98a2b3;
        background: #ffffff;
        Rectangle {
            x: 1px; y: -12px; width: 13px; height: 40px;
            accessible-role: radio-button;
            accessible-label: root.text;
            accessible-value: root.value;
            accessible-enabled: true;
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: checked ? #2e90fa : transparent;
        }
    }
    Text {
        x: 32px;
        width: root.width - 40px;
        height: root.height;
        text: root.text;
        color: Design.text;
        font-size: 14px;
        vertical-alignment: center;
    }
}

component PanelBox inherits Rectangle {
    background: Design.panel;
    border-color: Design.line;
    border-width: 1px;
    border-radius: 16px;
    clip: false;
    @children
}

component SearchResultRow inherits Rectangle {
    in property <CatalogChoice> item;
    in property <bool> active: false;
    in property <bool> show-rates: true;
    callback chosen(string);
    height: 65.96875px;

    content := Rectangle {
        x: 0px; y: 0px; width: 100%; height: 62.78125px;
        border-radius: 10px;
        background: active || touch.has-hover ? Design.accent-soft : transparent;
        accessible-role: button;
        accessible-label: item.item-code + " " + item.item-name + " Stock " + item.quantity-text + " " + (show-rates ? item.rate-text : "—");
        accessible-enabled: true;

        Rectangle {
            x: 0px; y: 0px; width: 100%; height: 100%;
            accessible-role: list-item;
            accessible-label: item.item-code + " " + item.item-name + " Stock " + item.quantity-text + " " + (show-rates ? item.rate-text : "—");
            accessible-enabled: true;
            accessible-item-selected: root.active;
        }
    }
    touch := TouchArea { height: 62.78125px; clicked => { root.chosen(item.item-code); } }
    Text {
        x: 10px;
        y: 7px;
        width: root.width - 150px;
        text: item.item-code;
        color: Design.text;
        font-size: 14px;
        font-weight: 700;
        overflow: elide;
    }
    Text {
        x: 10px;
        y: 30px;
        width: root.width - 150px;
        text: item.item-name;
        color: Design.muted;
        font-size: 12px;
        overflow: elide;
    }
    Text {
        x: root.width - 132px;
        y: 7px;
        width: 120px;
        text: "Stock " + item.quantity-text;
        color: Design.muted;
        font-size: 13px;
        font-weight: 800;
        horizontal-alignment: right;
    }
    Text {
        x: root.width - 132px;
        y: 30px;
        width: 120px;
        text: show-rates ? item.rate-text : "—";
        color: Design.accent-strong;
        font-size: 13px;
        font-weight: 800;
        horizontal-alignment: right;
    }
}

component VoucherLineRow inherits Rectangle {
    in property <VoucherLine> line;
    callback remove(string);
    callback increase(string);
    callback decrease(string);
    callback quantity-edited(string, string);
    height: 48px;
    property <length> qty-x: root.width * 0.28;

    Text { x: 14px; y: 3px; width: root.qty-x - 20px; height: 22px; text: line.item-name; color: Design.text; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
    Text { x: 14px; y: 27px; width: 300px; height: 17px; text: line.item-code; color: Design.muted; font-size: 11px; overflow: elide; }
    Rectangle {
        x: root.qty-x; y: 9.578125px; width: 40px; height: 40px;
        border-radius: 10px; border-color: Design.line; border-width: 1px; background: #ffffff;
        accessible-role: button; accessible-label: "Decrease quantity"; accessible-enabled: true;
        Text { text: "−"; color: Design.text; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.decrease(line.item-code); } }
    }
    LineEdit {
        x: root.qty-x + 40px; y: 9.578125px; width: 72px; height: 40px;
        text: line.qty-text;
        accessible-role: text-input;
        accessible-label: "Quantity";
        horizontal-alignment: center;
        accepted => { root.quantity-edited(line.item-code, self.text); }
    }
    Rectangle {
        x: root.qty-x + 112px; y: 9.578125px; width: 40px; height: 40px;
        border-radius: 10px; border-color: Design.line; border-width: 1px; background: #ffffff;
        accessible-role: button; accessible-label: "Increase quantity"; accessible-enabled: true;
        Text { text: "+"; color: Design.text; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.increase(line.item-code); } }
    }
    Text { x: root.width * 0.58; width: 70px; height: 48px; text: line.uom; color: Design.muted; font-size: 14px; vertical-alignment: center; }
    Text { x: root.width * 0.65; width: root.width * 0.11; height: 48px; text: line.rate-text; color: Design.text; font-size: 14px; horizontal-alignment: right; vertical-alignment: center; }
    Text { x: root.width * 0.76; width: root.width * 0.14; height: 48px; text: line.amount-text; color: Design.text; font-size: 14px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
    Rectangle {
        x: root.width - 107px; y: 9.578125px; width: 40px; height: 40px;
        border-radius: 10px; border-color: Design.line; border-width: 1px; background: #ffffff;
        accessible-role: button; accessible-label: "Remove line"; accessible-enabled: true;
        Text { text: "×"; color: Design.danger; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.remove(line.item-code); } }
    }
}

component CounterScreen inherits FocusScope {
    in property <bool> sales-mode;
    in property <[string]> warehouse-options;
    in property <[string]> customer-options;
    in property <[string]> payment-options;
    in property <[string]> target-warehouse-options;
    in property <[string]> transfer-mode-options;
    in property <length> initial-scroll-offset: 0px;
    in-out property <length> content-y: 0px;
    property <length> side-width: (root.width - 72px) * 0.39;
    property <length> field-width: (root.side-width - 54px) / 2;
    property <length> field-right-x: 21px + root.field-width + 12px;
    property <length> gutter: 16px;
    property <length> content-x: 28px + root.side-width + root.gutter;
    property <length> content-width: root.width - root.content-x - 28px;
    property <length> lines-width: root.width - 56px;
    property <length> lines-top: root.sales-mode ? 501px : 441px;
    property <length> lines-required-height: 96px + root.voucher-lines.length * 48px;
    property <length> lines-available-height: root.height - 72px - root.lines-top - 16px;
    property <length> lines-height: root.lines-available-height > root.lines-required-height ? root.lines-available-height : root.lines-required-height;
    in property <[CatalogChoice]> search-results;
    in property <[VoucherLine]> voucher-lines;
    in-out property <bool> search-open;
    in-out property <int> active-search-index: 0;
    in property <string> status-text;
    in property <string> total-qty-text;
    in property <string> subtotal-text;
    in-out property <bool> clear-scan-after-accept;
    callback navigate(int);
    callback warehouse-selected(string);
    callback customer-selected(string);
    callback payment-selected(string);
    callback target-warehouse-selected(string);
    callback transfer-mode-selected(string);
    callback outgoing-stock-entry-edited(string);
    callback search-edited(string);
    callback sales-scan-accepted(string);
    callback choose-item(string);
    callback remove-line(string);
    callback increase-line(string);
    callback decrease-line(string);
    callback line-quantity-edited(string, string);
    callback clear-lines();
    callback submit-print();

    init => {
        root.content-y = -root.initial-scroll-offset;
        item-search.focus();
    }
    key-pressed(event) => {
        if event.text == Key.F2 {
            item-search.focus();
            accept
        } else if event.text == Key.F9 {
            root.submit-print();
            accept
        } else if event.text == Key.DownArrow && root.search-open && root.search-results.length > 0 {
            root.active-search-index = mod(root.active-search-index + 1, root.search-results.length);
            accept
        } else if event.text == Key.UpArrow && root.search-open && root.search-results.length > 0 {
            root.active-search-index = mod(root.active-search-index + root.search-results.length - 1, root.search-results.length);
            accept
        } else if event.text == Key.Escape && root.search-open {
            root.search-open = false;
            root.active-search-index = 0;
            accept
        } else {
            reject
        }
    }

    page-scroll := Flickable {
        x: 0px; y: 0px; width: root.width; height: root.height;
        content-width: root.width;
        content-height: root.lines-top + root.lines-height + 92px;
        content-y <=> root.content-y;

    Rectangle {
        x: 0px; y: 0px; width: root.width; height: 80px;
        background: #ffffff;
        border-color: Design.line;
        border-width: 1px;
        Text { x: 32px; y: 12px; width: 220px; text: "KHITMEE OPS"; color: Design.accent; font-size: 12px; font-weight: 800; letter-spacing: 1px; }
        Text { x: 32px; y: 31px; width: 350px; text: root.sales-mode ? "Sales Counter" : "Stock Transfer"; color: Design.text; font-size: 29px; font-weight: 750; }
        Rectangle {
            x: root.width - 216px; y: 18px; width: 188px; height: 48px;
            border-radius: 24px;
            background: #e9eef3;
            NavPill { x: 9.140625px; y: 7.5px; width: 69.828125px; height: 40px; text: "Sales"; active: root.sales-mode; clicked => { root.navigate(0); } }
            NavPill { x: 86.96875px; y: 7.5px; width: 93.03125px; height: 40px; text: "Transfer"; active: !root.sales-mode; clicked => { root.navigate(1); } }
        }
    }

    PanelBox {
        x: 28px; y: 95px; width: root.side-width; height: root.sales-mode ? 390px : 330px;
        Text { x: 21px; y: 30px; text: root.sales-mode ? "Sale details" : "Transfer details"; color: Design.text; font-size: 16px; font-weight: 700; }

        Text { x: 21px; y: 67px; text: root.sales-mode ? "Shop warehouse" : "Source warehouse"; color: Design.muted; font-size: 13px; font-weight: 700; }
        ComboBox {
            x: 21px; y: 90.59375px; width: root.sales-mode ? root.field-width : root.side-width - 42px; height: 40px;
            model: root.warehouse-options;
            accessible-label: root.sales-mode ? "Shop warehouse" : "Source warehouse";
            selected(value) => { root.warehouse-selected(value); }
        }

        Text { visible: root.sales-mode; x: root.field-right-x; y: 67px; text: "Customer"; color: Design.muted; font-size: 13px; font-weight: 700; }
        LineEdit {
            visible: root.sales-mode;
            x: root.field-right-x; y: 90.59375px; width: root.field-width; height: 40px;
            input-type: search;
            placeholder-text: "Filter customers…";
            accessible-label: "Customer Choose customer Load more customers";
            font-size: 17px;
        }
        ComboBox {
            visible: root.sales-mode;
            x: root.field-right-x; y: 138px; width: root.field-width; height: 40px;
            model: root.customer-options;
            accessible-label: "";
            selected(value) => { root.customer-selected(value); }
        }
        BrowserButton { visible: root.sales-mode; x: root.field-right-x; y: 182px; width: root.field-width; height: 40px; text: "Load more customers"; }
        Text { visible: root.sales-mode; x: 21px; y: 234px; text: "Payment mode"; color: Design.muted; font-size: 13px; font-weight: 700; }
        ComboBox {
            visible: root.sales-mode;
            x: 21px; y: 258px; width: root.field-width; height: 40px;
            model: root.payment-options;
            accessible-label: "Payment mode";
            selected(value) => { root.payment-selected(value); }
        }
        Text { visible: root.sales-mode; x: root.field-right-x; y: 234px; text: "Print format"; color: Design.muted; font-size: 13px; font-weight: 700; }
        PrintRadio { visible: root.sales-mode; x: root.field-right-x; y: 258px; width: 143.0625px; height: 42px; text: "Voucher 80mm"; checked: true; value: "voucher"; }
        PrintRadio { visible: root.sales-mode; x: root.field-right-x; y: 304px; width: 107.828125px; height: 42px; text: "Canon A4"; checked: false; value: "a4"; }

        Text { visible: !root.sales-mode; x: root.field-right-x; y: 67px; text: "Target warehouse"; color: Design.muted; font-size: 13px; font-weight: 700; }
        ComboBox {
            visible: !root.sales-mode;
            x: root.field-right-x; y: 90.59375px; width: root.field-width; height: 40px;
            model: root.target-warehouse-options;
            accessible-label: "Target warehouse";
            selected(value) => { root.target-warehouse-selected(value); }
        }
        Text { visible: !root.sales-mode; x: 21px; y: 144px; text: "Transfer mode"; color: Design.muted; font-size: 13px; font-weight: 700; }
        transfer-mode-combo := ComboBox {
            visible: !root.sales-mode;
            x: 21px; y: 167.78125px; width: root.field-width; height: 40px;
            model: root.transfer-mode-options;
            accessible-label: "Transfer mode";
            selected(value) => { root.transfer-mode-selected(value); }
        }
        Text { visible: !root.sales-mode; x: root.field-right-x; y: 144px; text: "Outgoing stock entry"; color: Design.muted; font-size: 13px; font-weight: 700; }
        LineEdit {
            visible: !root.sales-mode;
            x: root.field-right-x; y: 167.78125px; width: root.field-width; height: 40px;
            enabled: transfer-mode-combo.current-value == "Receive from transit";
            placeholder-text: "Required in receive mode";
            accessible-enabled: transfer-mode-combo.current-value == "Receive from transit";
            accessible-role: text-input;
            accessible-label: "Outgoing stock entry";
            edited => { root.outgoing-stock-entry-edited(self.text); }
        }
        Text { visible: !root.sales-mode; x: 21px; y: 221px; text: "Print format"; color: Design.muted; font-size: 13px; font-weight: 700; }
        PrintRadio { visible: !root.sales-mode; x: 21px; y: 245px; width: 143.0625px; height: 42px; text: "Voucher 80mm"; checked: true; value: "voucher"; }
        PrintRadio { visible: !root.sales-mode; x: root.field-right-x; y: 245px; width: 107.828125px; height: 42px; text: "Canon A4"; checked: false; value: "a4"; }
    }

    PanelBox {
        x: root.content-x; y: 95px; width: root.content-width; height: root.sales-mode ? 390px : 330px;
        Text { x: 19px; y: 30px; text: "Scan or search"; color: Design.text; font-size: 16px; font-weight: 700; }
        Text { x: 19px; y: 64px; text: "Barcode / item search"; color: Design.muted; font-size: 13px; font-weight: 700; }
        Rectangle {
            x: 20px; y: 82px; width: 21px; height: 17px;
            border-color: Design.line; border-width: 1px; border-radius: 5px; background: #f8fafc;
            Text { text: "F2"; color: Design.muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
        }
        item-search := LineEdit {
            x: 19.421875px; y: 112.171875px; width: root.content-width - 40px; height: 48px;
            input-type: search;
            placeholder-text: "Scan barcode or type item name…";
            accessible-label: "Barcode / item search F2";
            accessible-expanded: root.search-open;
            font-size: 17px;
            accessible-role: combobox;
            edited => { root.search-edited(self.text); }
            key-pressed(event) => {
                if event.text == Key.DownArrow && root.search-open && root.search-results.length > 0 {
                    root.active-search-index = mod(root.active-search-index + 1, root.search-results.length);
                    accept
                } else if event.text == Key.UpArrow && root.search-open && root.search-results.length > 0 {
                    root.active-search-index = mod(root.active-search-index + root.search-results.length - 1, root.search-results.length);
                    accept
                } else if event.text == Key.Escape && root.search-open {
                    root.search-open = false;
                    root.active-search-index = 0;
                    self.text = "";
                    accept
                } else {
                    reject
                }
            }
            accepted => {
                root.sales-scan-accepted(self.text);
                if root.clear-scan-after-accept { self.text = ""; }
            }
        }
        Rectangle {
            visible: item-search.has-focus;
            x: 15px; y: 108px; width: root.content-width - 31px; height: 56px;
            border-radius: 14px;
            border-width: 3px;
            border-color: #86b7fe;
            background: transparent;
        }
    }

    PanelBox {
        x: 28px; y: root.lines-top; width: root.lines-width; height: root.lines-height;
        border-radius: 14px;
        Rectangle { x: 0px; y: 0px; width: root.lines-width; height: 72px; border-color: Design.line; border-width: 1px; }
        Text { x: 21px; y: 22px; text: "Lines"; color: Design.text; font-size: 16px; font-weight: 700; }
        BrowserButton { x: root.lines-width - 87.65625px; y: 13.140625px; width: 66.640625px; height: 40px; text: "Clear"; clicked => { root.clear-lines(); } }
        Rectangle {
            x: 5px; y: 66.9375px; width: root.lines-width - 10px;
            accessible-role: region;
            accessible-label: root.sales-mode ? "Sale lines" : "Transfer lines";
            height: 34.59375px + root.voucher-lines.length * 61.09375px;
        }
        Rectangle { x: 0px; y: 66px; width: root.lines-width; height: 36px; background: #f8fafc; }
        Text { x: 15px; y: 75px; width: 300px; text: "ITEM"; color: Design.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; }
        Text { x: root.lines-width * 0.28; y: 75px; width: root.lines-width * 0.18; text: "QTY"; color: Design.muted; font-size: 12px; font-weight: 700; horizontal-alignment: center; letter-spacing: 0.5px; }
        Text { x: root.lines-width * 0.58; y: 75px; width: 70px; text: "UOM"; color: Design.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; }
        Text { x: root.lines-width * 0.65; y: 75px; width: root.lines-width * 0.11; text: "RATE"; color: Design.muted; font-size: 12px; font-weight: 700; horizontal-alignment: right; letter-spacing: 0.5px; }
        Text { x: root.lines-width * 0.76; y: 75px; width: root.lines-width * 0.14; text: "AMOUNT"; color: Design.muted; font-size: 12px; font-weight: 700; horizontal-alignment: right; letter-spacing: 0.5px; }
        ListView {
            x: 0px; y: 102px; width: root.lines-width; height: root.voucher-lines.length * 48px;
            for row in root.voucher-lines: VoucherLineRow {
                width: parent.width;
                line: row;
                remove(code) => { root.remove-line(code); }
                increase(code) => { root.increase-line(code); }
                decrease(code) => { root.decrease-line(code); }
                quantity-edited(code, value) => { root.line-quantity-edited(code, value); }
            }
        }
    }

    if root.voucher-lines.length > 0: Rectangle {
        x: 28px; y: 687px; width: root.lines-width; height: 0px;
    }

    }

    if root.search-open: Rectangle {
        x: root.content-x + 16px; y: (root.sales-mode ? 473px : 415px) + root.content-y; width: root.content-width - 32px; height: 384px;
        background: #ffffff;
        border-color: Design.line;
        border-width: 1px;
        border-radius: 14px;
        Rectangle {
            x: 3.421875px; y: -2.0625px; width: root.content-width - 40px; height: 384px;
            accessible-role: list;
            accessible-label: "Item search results";
            accessible-enabled: true;
        }
        Rectangle {
            x: 10.015625px; y: 4.53125px; width: root.content-width - 52px; height: 660px;
            for row[index] in root.search-results: SearchResultRow {
                x: 0px; y: index * 65.96875px;
                width: root.content-width - 52px;
                item: row;
                active: index == root.active-search-index;
                show-rates: root.sales-mode;
                chosen(code) => { root.choose-item(code); item-search.text = ""; }
            }
        }
    }



    Rectangle {
        x: 0px; y: root.height - 72px; width: root.width; height: 72px;
        background: #ffffff;
        border-color: Design.line;
        border-width: 1px;
        Text { x: 28px; y: 24px; width: 100px; text: "Total qty"; color: Design.text; font-size: 14px; vertical-alignment: center; }
        Text { x: 102px; y: 19px; width: 35px; text: root.total-qty-text; color: Design.text; font-size: 20px; font-weight: 800; vertical-alignment: center; }
        Text { x: 150px; y: 24px; width: 70px; text: root.sales-mode ? "Subtotal" : "Total"; color: Design.text; font-size: 14px; vertical-alignment: center; }
        Text { x: 224px; y: 19px; width: 70px; text: root.subtotal-text; color: Design.text; font-size: 20px; font-weight: 800; vertical-alignment: center; }
        status-text := Text {
            x: root.sales-mode ? (root.subtotal-text == "0.00" ? 241.953125px : 253px) : 189.09375px; y: 26px; width: root.width - 488px; height: 20px;
            text: root.status-text;
            accessible-label: root.status-text;
            color: Design.muted;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            accessible-live-region: polite;
        }
        BrowserButton { x: root.width - 218.8125px; y: 12px; width: 186.8125px; height: 48px; text: "Submit & Print  F9"; primary: true; enabled: root.voucher-lines.length > 0; clicked => { root.submit-print(); } }
    }
}

component InvoiceSkeletonControl inherits Rectangle {
    in property <string> label-text;
    border-width: 0px;
    background: transparent;
    accessible-label: label-text;
    accessible-enabled: true;
    if label-text != "": Text { x: 0px; y: 0px; width: 100%; height: 100%; text: label-text; color: #344054; font-size: 11px; overflow: elide; vertical-alignment: center; }
}

component InvoiceGeneratedRow inherits Rectangle {
    in property <InvoiceRow> invoice;
    in property <int> index;
    callback open-invoice(string);
    height: 41px;
    y: 190px + index * 41px;
    accessible-role: list-item;
    accessible-label: invoice.customer + "|" + invoice.status + "|" + invoice.posting-date + "|" + invoice.due-date + "|" + "$ " + invoice.total-text + "|" + invoice.name;
    property <length> content-width: root.width - 240px;

    TouchArea { clicked => { root.open-invoice(invoice.name); } }

    Rectangle {
        x: 311px; y: 3px; width: 14px; height: 14px;
        accessible-role: checkbox; accessible-label: "on"; accessible-value: "on"; accessible-enabled: true;
        background: transparent;
    }

    Rectangle {
        x: 250px + root.content-width * 0.02; y: 0.59375px; width: root.content-width * 0.15; height: 18.796875px;
        accessible-role: button; accessible-label: invoice.customer; accessible-enabled: true;
        background: transparent;
        Text { width: 100%; height: 100%; text: invoice.customer; color: Design.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
    }

    Rectangle {
        x: 250px + root.content-width * 0.19; y: 2.84375px; width: root.content-width * 0.08; height: 17px;
        accessible-role: button; accessible-label: invoice.status; accessible-enabled: true;
        background: transparent;
        Text { width: 100%; height: 100%; text: invoice.status; color: Design.muted; font-size: 11px; vertical-alignment: center; overflow: elide; }
    }

    Rectangle {
        x: 250px + root.content-width * 0.29; y: 2.84375px; width: root.content-width * 0.10; height: 17px;
        accessible-role: button; accessible-label: invoice.posting-date; accessible-enabled: true;
        background: transparent;
        Text { width: 100%; height: 100%; text: invoice.posting-date; color: Design.muted; font-size: 11px; vertical-alignment: center; overflow: elide; }
    }

    Rectangle {
        x: 250px + root.content-width * 0.41; y: 2.84375px; width: root.content-width * 0.10; height: 17px;
        accessible-role: button; accessible-label: invoice.due-date; accessible-enabled: true;
        background: transparent;
        Text { width: 100%; height: 100%; text: invoice.due-date; color: Design.muted; font-size: 11px; vertical-alignment: center; overflow: elide; }
    }

    Rectangle {
        x: 250px + root.content-width * 0.55; y: 0px; width: root.content-width * 0.12; height: 21px;
        accessible-role: button; accessible-label: "$ " + invoice.total-text; accessible-enabled: true;
        background: transparent;
        Text { width: 100%; height: 100%; text: "$ " + invoice.total-text; color: Design.text; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    }

    Rectangle {
        x: 250px + root.content-width * 0.70; y: 0.15625px; width: root.content-width * 0.26; height: 19.6875px;
        accessible-role: button; accessible-label: invoice.name; accessible-enabled: true;
        background: transparent;
        Text { width: 100%; height: 100%; text: invoice.name; color: Design.focus; font-size: 11px; vertical-alignment: center; overflow: elide; }
    }

}

component InvoiceScreen inherits Rectangle {
    in property <[InvoiceRow]> invoice-rows;
    in-out property <string> invoice-filter-text;
    in property <string> invoice-count-text;
    in property <string> invoice-error-text;
    in property <string> invoice-sort-label;
    callback invoice-filter-edited(string);
    callback invoice-load-more();
    callback invoice-sort-toggle();
    callback invoice-open(string);
    callback invoice-detail-field-edited(string, string);
    callback invoice-detail-save();
    callback invoice-detail-submit();
    callback invoice-detail-item-open(int);
    callback invoice-detail-item-qty-edited(int, string);
    callback invoice-detail-item-rate-edited(int, string);
    callback invoice-detail-item-code-edited(int, string);
    callback invoice-detail-item-add();
    callback invoice-detail-item-select(int);
    callback invoice-detail-item-delete();
    callback invoice-detail-validation-close();
    background: #f4f5f7;

    Rectangle { x: 0px; y: 0px; width: 240px; height: parent.height; background: #f8fafc; }
    Rectangle { x: 240px; y: 0px; width: parent.width - 240px; height: parent.height; background: #ffffff; }
    Text { x: 258px; y: 12px; width: 180px; height: 24px; text: "Sales Invoice"; accessible-label: "Sales Invoice"; color: #17202a; font-size: 15px; font-weight: 650; }

