import { AboutSlint, LineEdit, ListView } from "std-widgets.slint";

export struct CatalogChoice {
    item-code: string,
    item-name: string,
    uom: string,
    rate-text: string,
    quantity-text: string,
    barcode: string,
}

export struct VoucherLine {
    item-code: string,
    item-name: string,
    qty-text: string,
    uom: string,
    rate-text: string,
    amount-text: string,
}

export struct InvoiceRow {
    name: string,
    customer: string,
    posting-date: string,
    due-date: string,
    total-text: string,
    status: string,
}

global Design {
    out property <color> bg: #f4f6f8;
    out property <color> panel: #ffffff;
    out property <color> text: #17202a;
    out property <color> muted: #667085;
    out property <color> line: #d8dee6;
    out property <color> accent: #146c43;
    out property <color> accent-strong: #0f5132;
    out property <color> accent-soft: #e7f6ee;
    out property <color> focus: #2e90fa;
    out property <color> danger: #b42318;
}

component NavPill inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    border-radius: 20px;
    background: active ? #ffffff : transparent;
    accessible-role: button;
    accessible-label: text;

    touch := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: Design.text;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component BrowserSelect inherits Rectangle {
    in property <string> value;
    in property <bool> disabled: false;
    background: #ffffff;
    border-color: Design.line;
    border-width: 1px;
    border-radius: 12px;
    accessible-role: combobox;
    accessible-label: value;
    accessible-enabled: !disabled;

    Text {
        x: 12px;
        width: root.width - 34px;
        height: root.height;
        text: root.value;
        color: root.disabled ? Design.muted : Design.text;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: root.width - 24px;
        width: 16px;
        height: root.height;
        text: "▾";
        color: Design.muted;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component BrowserButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    opacity: enabled ? 1.0 : 0.55;
    background: primary ? Design.accent : #ffffff;
    border-color: primary ? Design.accent : Design.line;
    border-width: 1px;
    border-radius: 12px;
    accessible-role: button;
    accessible-label: text;

    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: primary ? #ffffff : Design.text;
        font-size: 14px;
        font-weight: primary ? 900 : 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component PrintRadio inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    background: #ffffff;
    border-color: Design.line;
    border-width: 1px;
    border-radius: 20px;
    accessible-role: radio-button;
    accessible-label: text;

    Rectangle {
        x: 12px;
        y: 13px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 1px;
        border-color: checked ? #2e90fa : #98a2b3;
        background: #ffffff;
        Rectangle {
            x: 3px;
            y: 3px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: checked ? #2e90fa : transparent;
        }
    }
    Text {
        x: 32px;
        width: root.width - 40px;
        height: root.height;
        text: root.text;
        color: Design.text;
        font-size: 14px;
        vertical-alignment: center;
    }
}

component PanelBox inherits Rectangle {
    background: Design.panel;
    border-color: Design.line;
    border-width: 1px;
    border-radius: 16px;
    clip: false;
    @children
}

component SearchResultRow inherits Rectangle {
    in property <CatalogChoice> item;
    in property <bool> active: false;
    callback chosen(string);
    height: 56px;
    border-radius: 10px;
    background: active || touch.has-hover ? Design.accent-soft : transparent;
    accessible-role: button;
    accessible-label: item.item-name;

    touch := TouchArea { clicked => { root.chosen(item.item-code); } }
    Text {
        x: 10px;
        y: 7px;
        width: root.width - 150px;
        text: item.item-code;
        color: Design.text;
        font-size: 14px;
        font-weight: 700;
        overflow: elide;
    }
    Text {
        x: 10px;
        y: 30px;
        width: root.width - 150px;
        text: item.item-name;
        color: Design.muted;
        font-size: 12px;
        overflow: elide;
    }
    Text {
        x: root.width - 132px;
        y: 7px;
        width: 120px;
        text: "Stock " + item.quantity-text;
        color: Design.muted;
        font-size: 13px;
        font-weight: 800;
        horizontal-alignment: right;
    }
    Text {
        x: root.width - 132px;
        y: 30px;
        width: 120px;
        text: item.rate-text;
        color: Design.accent-strong;
        font-size: 13px;
        font-weight: 800;
        horizontal-alignment: right;
    }
}

component VoucherLineRow inherits Rectangle {
    in property <VoucherLine> line;
    callback remove(string);
    height: 48px;

    Text { x: 14px; width: 300px; height: 48px; text: line.item-name; color: Design.text; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
    Text { x: 14px; y: 28px; width: 300px; text: line.item-code; color: Design.muted; font-size: 11px; overflow: elide; }
    Text { x: 325px; width: 315px; height: 48px; text: line.qty-text; color: Design.text; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
    Text { x: 660px; width: 70px; height: 48px; text: line.uom; color: Design.muted; font-size: 14px; vertical-alignment: center; }
    Text { x: 730px; width: 130px; height: 48px; text: line.rate-text; color: Design.text; font-size: 14px; horizontal-alignment: right; vertical-alignment: center; }
    Text { x: 860px; width: 175px; height: 48px; text: line.amount-text; color: Design.text; font-size: 14px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
    BrowserButton {
        x: 1045px;
        y: 5px;
        width: 68px;
        height: 38px;
        text: "Remove";
        clicked => { root.remove(line.item-code); }
    }
}

component CounterScreen inherits FocusScope {
    in property <bool> sales-mode;
    in property <length> scroll-offset: 0px;
    in property <[CatalogChoice]> search-results;
    in property <[VoucherLine]> voucher-lines;
    in property <bool> search-open;
    in property <string> status-text;
    in property <string> total-qty-text;
    in property <string> subtotal-text;
    in-out property <bool> clear-scan-after-accept;
    callback navigate(int);
    callback search-edited(string);
    callback sales-scan-accepted(string);
    callback choose-item(string);
    callback remove-line(string);
    callback clear-lines();
    callback submit-print();

    init => { item-search.focus(); }
    key-pressed(event) => {
        if event.text == Key.F2 {
            item-search.focus();
            accept
        } else {
            reject
        }
    }

    Rectangle {
        x: 0px; y: 0px - root.scroll-offset; width: 1180px; height: 80px;
        background: #ffffff;
        border-color: Design.line;
        border-width: 1px;
        Text { x: 32px; y: 12px; width: 220px; text: "KHITMEE OPS"; color: Design.accent; font-size: 12px; font-weight: 800; letter-spacing: 1px; }
        Text { x: 32px; y: 31px; width: 350px; text: root.sales-mode ? "Sales Counter" : "Stock Transfer"; color: Design.text; font-size: 29px; font-weight: 750; }
        Rectangle {
            x: 964px; y: 18px; width: 188px; height: 48px;
            border-radius: 24px;
            background: #e9eef3;
            NavPill { x: 9px; y: 8px; width: 70px; height: 40px; text: "Sales"; active: root.sales-mode; clicked => { root.navigate(0); } }
            NavPill { x: 87px; y: 8px; width: 93px; height: 40px; text: "Transfer"; active: !root.sales-mode; clicked => { root.navigate(1); } }
        }
    }

    PanelBox {
        x: 28px; y: 95px - root.scroll-offset; width: 432px; height: root.sales-mode ? 481px : 457px;
        Text { x: 21px; y: 30px; text: root.sales-mode ? "Sale details" : "Transfer details"; color: Design.text; font-size: 16px; font-weight: 700; }

        Text { x: 21px; y: 67px; text: root.sales-mode ? "Shop warehouse" : "Source warehouse"; color: Design.muted; font-size: 13px; font-weight: 700; }
        BrowserSelect { x: 21px; y: 91px; width: 396px; height: 40px; value: "Dist Hub 1"; }

        Text { visible: root.sales-mode; x: 21px; y: 144px; text: "Customer"; color: Design.muted; font-size: 13px; font-weight: 700; }
        LineEdit {
            visible: root.sales-mode;
            x: 21px; y: 168px; width: 396px; height: 48px;
            input-type: search;
            placeholder-text: "Filter customers…";
            font-size: 17px;
        }
        BrowserSelect { visible: root.sales-mode; x: 21px; y: 221px; width: 396px; height: 40px; value: "Choose customer"; }
        BrowserButton { visible: root.sales-mode; x: 21px; y: 267px; width: 396px; height: 40px; text: "Load more customers"; }
        Text { visible: root.sales-mode; x: 21px; y: 320px; text: "Payment mode"; color: Design.muted; font-size: 13px; font-weight: 700; }
        BrowserSelect { visible: root.sales-mode; x: 21px; y: 344px; width: 396px; height: 40px; value: "No payment / credit"; }
        Text { visible: root.sales-mode; x: 21px; y: 397px; text: "Print format"; color: Design.muted; font-size: 13px; font-weight: 700; }
        PrintRadio { visible: root.sales-mode; x: 21px; y: 422px; width: 143px; height: 42px; text: "Voucher 80mm"; checked: true; }
        PrintRadio { visible: root.sales-mode; x: 174px; y: 421px; width: 108px; height: 42px; text: "Canon A4"; checked: false; }

        Text { visible: !root.sales-mode; x: 21px; y: 144px; text: "Target warehouse"; color: Design.muted; font-size: 13px; font-weight: 700; }
        BrowserSelect { visible: !root.sales-mode; x: 21px; y: 168px; width: 396px; height: 40px; value: "Choose target warehouse"; }
        Text { visible: !root.sales-mode; x: 21px; y: 221px; text: "Transfer mode"; color: Design.muted; font-size: 13px; font-weight: 700; }
        BrowserSelect { visible: !root.sales-mode; x: 21px; y: 245px; width: 396px; height: 40px; value: "Direct transfer"; }
        Text { visible: !root.sales-mode; x: 21px; y: 298px; text: "Outgoing stock entry"; color: Design.muted; font-size: 13px; font-weight: 700; }
        LineEdit {
            visible: !root.sales-mode;
            x: 21px; y: 322px; width: 396px; height: 40px;
            enabled: false;
            placeholder-text: "Required in receive mode";
        }
        Text { visible: !root.sales-mode; x: 21px; y: 375px; text: "Print format"; color: Design.muted; font-size: 13px; font-weight: 700; }
        PrintRadio { visible: !root.sales-mode; x: 21px; y: 400px; width: 143px; height: 42px; text: "Voucher 80mm"; checked: true; }
        PrintRadio { visible: !root.sales-mode; x: 174px; y: 399px; width: 108px; height: 42px; text: "Canon A4"; checked: false; }
    }

    PanelBox {
        x: 476px; y: 95px - root.scroll-offset; width: 676px; height: root.sales-mode ? 481px : 457px;
        Text { x: 19px; y: 30px; text: "Scan or search"; color: Design.text; font-size: 16px; font-weight: 700; }
        Text { x: 19px; y: 64px; text: "Barcode / item search"; color: Design.muted; font-size: 13px; font-weight: 700; }
        Rectangle {
            x: 20px; y: 82px; width: 21px; height: 17px;
            border-color: Design.line; border-width: 1px; border-radius: 5px; background: #f8fafc;
            Text { text: "F2"; color: Design.muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
        }
        item-search := LineEdit {
            x: 19px; y: 112px; width: 636px; height: 48px;
            input-type: search;
            placeholder-text: "Scan barcode or type item name…";
            font-size: 17px;
            accessible-role: combobox;
            edited => { root.search-edited(self.text); }
            accepted => {
                root.sales-scan-accepted(self.text);
                if root.clear-scan-after-accept { self.text = ""; } else { self.select-all(); }
            }
        }
        Rectangle {
            visible: item-search.has-focus;
            x: 15px; y: 108px; width: 644px; height: 56px;
            border-radius: 14px;
            border-width: 3px;
            border-color: #86b7fe;
            background: transparent;
        }
    }

    PanelBox {
        x: 28px; y: (root.sales-mode ? 592px : 570px) - root.scroll-offset; width: 1124px; height: 96px + root.voucher-lines.length * 48px;
        border-radius: 14px;
        Rectangle { x: 0px; y: 0px; width: 1124px; height: 72px; border-color: Design.line; border-width: 1px; }
        Text { x: 21px; y: 22px; text: "Lines"; color: Design.text; font-size: 16px; font-weight: 700; }
        BrowserButton { x: 1036px; y: 13px; width: 67px; height: 40px; text: "Clear"; clicked => { root.clear-lines(); } }
        Rectangle { x: 0px; y: 66px; width: 1124px; height: 36px; background: #f8fafc; }
        Text { x: 15px; y: 75px; width: 300px; text: "ITEM"; color: Design.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; }
        Text { x: 320px; y: 75px; width: 325px; text: "QTY"; color: Design.muted; font-size: 12px; font-weight: 700; horizontal-alignment: center; letter-spacing: 0.5px; }
        Text { x: 660px; y: 75px; width: 70px; text: "UOM"; color: Design.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; }
        Text { x: 730px; y: 75px; width: 130px; text: "RATE"; color: Design.muted; font-size: 12px; font-weight: 700; horizontal-alignment: right; letter-spacing: 0.5px; }
        Text { x: 860px; y: 75px; width: 175px; text: "AMOUNT"; color: Design.muted; font-size: 12px; font-weight: 700; horizontal-alignment: right; letter-spacing: 0.5px; }
        ListView {
            x: 0px; y: 102px; width: 1124px; height: root.voucher-lines.length * 48px;
            for row in root.voucher-lines: VoucherLineRow {
                line: row;
                remove(code) => { root.remove-line(code); }
            }
        }
    }

    if root.search-open: Rectangle {
        x: 492px; y: 566px - root.scroll-offset; width: 644px; height: 384px;
        background: #ffffff;
        border-color: Design.line;
        border-width: 1px;
        border-radius: 14px;
        clip: true;
        ListView {
            x: 5px; y: 5px; width: 634px; height: 374px;
            for row[index] in root.search-results: SearchResultRow {
                item: row;
                active: index == 0;
                chosen(code) => { root.choose-item(code); }
            }
        }
    }


    if root.voucher-lines.length > 0: Rectangle {
        x: 28px; y: 687px; width: 1124px; height: 0px;
    }

    Rectangle {
        x: 0px; y: 688px; width: 1180px; height: 72px;
        background: #ffffff;
        border-color: Design.line;
        border-width: 1px;
        Text { x: 28px; y: 24px; width: 100px; text: "Total qty"; color: Design.text; font-size: 14px; vertical-alignment: center; }
        Text { x: 102px; y: 19px; width: 35px; text: root.total-qty-text; color: Design.text; font-size: 20px; font-weight: 800; vertical-alignment: center; }
        Text { x: 150px; y: 24px; width: 70px; text: root.sales-mode ? "Subtotal" : "Total"; color: Design.text; font-size: 14px; vertical-alignment: center; }
        Text { x: 224px; y: 19px; width: 70px; text: root.subtotal-text; color: Design.text; font-size: 20px; font-weight: 800; vertical-alignment: center; }
        Text { x: 330px; y: 26px; width: 620px; text: root.status-text; color: Design.muted; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        BrowserButton { x: 961px; y: 12px; width: 187px; height: 48px; text: "Submit & Print  F9"; primary: true; enabled: root.voucher-lines.length > 0; clicked => { root.submit-print(); } }
    }
}

component InvoiceListRow inherits Rectangle {
    in property <InvoiceRow> invoice;
    height: 36px;
    background: #ffffff;
    accessible-role: list-item;
    accessible-label: invoice.customer + " " + invoice.name;

    Rectangle { x: 0px; y: 35px; width: 915px; height: 1px; background: #eceff3; }
    Rectangle { x: 10px; y: 10px; width: 15px; height: 15px; border-color: #c8ccd2; border-width: 1px; border-radius: 3px; background: #ffffff; }
    Text { x: 36px; y: 8px; width: 78px; text: invoice.customer; color: #344054; font-size: 13px; overflow: elide; }
    Rectangle {
        x: 104px; y: 7px; width: invoice.status == "Return" ? 50px : 54px; height: 21px; border-radius: 5px; background: invoice.status == "Return" ? #eceff3 : #fff3cd;
        Text { text: invoice.status; color: invoice.status == "Return" ? #667085 : #996f00; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 205px; y: 8px; width: 98px; text: invoice.posting-date; color: #344054; font-size: 13px; horizontal-alignment: center; }
    Text { x: 315px; y: 8px; width: 98px; text: invoice.due-date; color: #344054; font-size: 13px; horizontal-alignment: center; }
    Text { x: 430px; y: 8px; width: 85px; text: "$ " + invoice.total-text; color: #344054; font-size: 13px; horizontal-alignment: right; }
    Text { x: 525px; y: 8px; width: 110px; text: invoice.name; color: #667085; font-size: 13px; overflow: elide; }
    Text { x: 690px; y: 8px; width: 28px; text: "💬 0"; color: #667085; font-size: 12px; horizontal-alignment: right; }
    Text { x: 730px; y: 8px; width: 20px; text: "·"; color: #667085; font-size: 13px; horizontal-alignment: center; }
    Text { x: 754px; y: 8px; width: 20px; text: "♡"; color: #667085; font-size: 13px; horizontal-alignment: center; }
}

component InvoiceScreen inherits Rectangle {
    in property <[InvoiceRow]> invoice-rows;
    in-out property <string> invoice-filter-text;
    callback invoice-filter-edited(string);
    background: #f4f5f7;

    Rectangle {
        x: 0px; y: 0px; width: 236px; height: 760px; background: #f8fafc; border-color: #e4e7ec; border-width: 1px;
        Rectangle { x: 10px; y: 10px; width: 28px; height: 28px; border-radius: 7px; background: #168bfa; Text { text: "F"; color: #ffffff; font-size: 18px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
        Text { x: 62px; y: 16px; width: 145px; text: "Accounts"; color: #17202a; font-size: 13px; font-weight: 650; }
        Text { x: 212px; y: 15px; width: 15px; text: "⌄"; color: #667085; font-size: 15px; horizontal-alignment: center; }
        Text { x: 24px; y: 66px; width: 20px; text: "⌂"; color: #667085; font-size: 15px; }
        Text { x: 68px; y: 68px; text: "Home"; color: #344054; font-size: 13px; }
        Text { x: 24px; y: 96px; width: 20px; text: "▥"; color: #667085; font-size: 14px; }
        Text { x: 68px; y: 98px; text: "Dashboard"; color: #344054; font-size: 13px; }
        Text { x: 24px; y: 126px; width: 20px; text: "▦"; color: #667085; font-size: 14px; }
        Text { x: 68px; y: 128px; text: "Chart of Accounts"; color: #344054; font-size: 13px; }
        Rectangle { x: 8px; y: 153px; width: 220px; height: 32px; border-radius: 6px; background: #e9eef3; }
        Text { x: 24px; y: 160px; width: 20px; text: "▤"; color: #667085; font-size: 14px; }
        Text { x: 68px; y: 161px; text: "Sales Invoice"; color: #17202a; font-size: 13px; font-weight: 700; }
        Text { x: 24px; y: 192px; width: 20px; text: "▤"; color: #667085; font-size: 14px; }
        Text { x: 68px; y: 194px; text: "Purchase Invoice"; color: #344054; font-size: 13px; }
        Text { x: 24px; y: 225px; width: 20px; text: "▤"; color: #667085; font-size: 14px; }
        Text { x: 68px; y: 227px; text: "Payment Entry"; color: #344054; font-size: 13px; }
        Text { x: 24px; y: 257px; width: 20px; text: "▤"; color: #667085; font-size: 14px; }
        Text { x: 68px; y: 259px; text: "Journal Entry"; color: #344054; font-size: 13px; }
        Text { x: 24px; y: 292px; width: 20px; text: "▦"; color: #667085; font-size: 14px; }
        Text { x: 68px; y: 294px; text: "Reports"; color: #344054; font-size: 13px; }
        Text { x: 24px; y: 325px; width: 20px; text: "▦"; color: #667085; font-size: 14px; }
        Text { x: 68px; y: 327px; text: "Banking"; color: #344054; font-size: 13px; }
        Text { x: 24px; y: 357px; width: 20px; text: "◉"; color: #667085; font-size: 13px; }
        Text { x: 68px; y: 359px; text: "Taxes"; color: #344054; font-size: 13px; }
        Text { x: 24px; y: 390px; width: 20px; text: "◎"; color: #667085; font-size: 13px; }
        Text { x: 68px; y: 392px; text: "Budgeting"; color: #344054; font-size: 13px; }
        Text { x: 24px; y: 423px; width: 20px; text: "⚙"; color: #667085; font-size: 14px; }
        Text { x: 68px; y: 425px; text: "Setup"; color: #344054; font-size: 13px; }
        Rectangle { x: 10px; y: 724px; width: 28px; height: 28px; border-radius: 14px; background: #c8f5d2; Text { text: "A"; color: #146c43; font-size: 14px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
    }

    Rectangle {
        x: 236px; y: 0px; width: 944px; height: 52px; background: #ffffff; border-color: #e4e7ec; border-width: 1px;
        Text { x: 22px; y: 15px; width: 180px; text: "Sales Invoice"; color: #17202a; font-size: 15px; font-weight: 650; }
        BrowserButton { x: 522px; y: 10px; width: 112px; height: 30px; text: "☰  List View  ⌄"; }
        BrowserButton { x: 648px; y: 10px; width: 32px; height: 30px; text: "⟳"; }
        BrowserButton { x: 688px; y: 10px; width: 32px; height: 30px; text: "⋯"; }
        Rectangle {
            x: 724px; y: 7px; width: 198px; height: 36px; border-radius: 7px; background: #171717;
            accessible-role: button; accessible-label: "Add Sales Invoice";
            Text { text: "+  Add Sales Invoice   ⌄"; color: #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
    }

    Rectangle {
        x: 236px; y: 52px; width: 944px; height: 77px; background: #ffffff; border-color: #e4e7ec; border-width: 1px;
        invoice-filter := LineEdit {
            x: 62px; y: 8px; width: 150px; height: 31px;
            placeholder-text: "ID";
            font-size: 12px;
            text <=> root.invoice-filter-text;
            edited => { root.invoice-filter-edited(self.text); }
        }
        Text { x: 220px; y: 14px; width: 20px; text: "≈"; color: #667085; font-size: 14px; }
        BrowserSelect { x: 248px; y: 8px; width: 116px; height: 31px; value: "Company"; }
        BrowserSelect { x: 380px; y: 8px; width: 116px; height: 31px; value: "Customer"; }
        Text { x: 695px; y: 14px; width: 80px; text: "☰  Filter"; color: #344054; font-size: 13px; font-weight: 650; horizontal-alignment: center; }
        Text { x: 803px; y: 14px; width: 105px; text: "⧨   Created On  ⌄"; color: #344054; font-size: 13px; font-weight: 650; horizontal-alignment: center; }
        LineEdit { x: 62px; y: 45px; width: 150px; height: 31px; placeholder-text: "Customer Name"; font-size: 12px; enabled: false; }
        Text { x: 220px; y: 51px; width: 20px; text: "≈"; color: #667085; font-size: 14px; }
        LineEdit { x: 248px; y: 45px; width: 116px; height: 31px; placeholder-text: "Posting Date"; font-size: 12px; enabled: false; }
        BrowserSelect { x: 380px; y: 45px; width: 116px; height: 31px; value: "Status"; }
    }

    Rectangle {
        x: 250px; y: 136px; width: 916px; height: 36px; background: #f8fafc; border-color: #e4e7ec; border-width: 1px; border-radius: 6px;
        Rectangle { x: 10px; y: 10px; width: 15px; height: 15px; border-color: #c8ccd2; border-width: 1px; border-radius: 3px; background: #ffffff; }
        Text { x: 36px; y: 9px; width: 75px; text: "Customer N…"; color: #667085; font-size: 12px; overflow: elide; }
        Text { x: 110px; y: 9px; width: 55px; text: "Status"; color: #667085; font-size: 12px; }
        Text { x: 205px; y: 9px; width: 95px; text: "Posting Date"; color: #667085; font-size: 12px; }
        Text { x: 315px; y: 9px; width: 105px; text: "Payment Due …"; color: #667085; font-size: 12px; overflow: elide; }
        Text { x: 430px; y: 9px; width: 85px; text: "Grand Total"; color: #667085; font-size: 12px; horizontal-alignment: right; }
        Text { x: 525px; y: 9px; width: 60px; text: "ID"; color: #667085; font-size: 12px; }
        Text { x: 770px; y: 9px; width: 100px; text: "20 of 1,000+   ♡"; color: #667085; font-size: 12px; horizontal-alignment: right; }
    }

    Rectangle {
        x: 250px; y: 172px; width: 916px; height: 552px; clip: true;
        ListView {
            x: 0px; y: 0px; width: 916px; height: 552px;
            for row in root.invoice-rows: InvoiceListRow { invoice: row; }
        }
    }

    Rectangle {
        x: 236px; y: 724px; width: 944px; height: 36px; background: #f8fafc; border-color: #e4e7ec; border-width: 1px;
        Text { x: 24px; y: 9px; width: 30px; text: "20"; color: #344054; font-size: 12px; }
        Text { x: 70px; y: 9px; width: 35px; text: "100"; color: #667085; font-size: 12px; }
        Text { x: 120px; y: 9px; width: 35px; text: "500"; color: #667085; font-size: 12px; }
        Text { x: 170px; y: 9px; width: 40px; text: "2500"; color: #667085; font-size: 12px; }
        Text { x: 832px; y: 9px; width: 90px; text: "Load More"; color: #344054; font-size: 12px; font-weight: 650; horizontal-alignment: right; }
    }
}

export component AppWindow inherits Window {
    title: "Khitmee Native Counter";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 1180px;
    min-height: 760px;
    background: Design.bg;

    in property <[CatalogChoice]> search-results: [];
    in property <[VoucherLine]> voucher-lines: [];
    in property <[InvoiceRow]> invoice-rows: [];
    in-out property <string> status-text: "Ready. Scan a barcode or press F2 to search.";
    in-out property <string> total-qty-text: "0";
    in-out property <string> subtotal-text: "0.00";
    in-out property <int> current-screen: 0;
    in-out property <string> fixture-note: "Fixture catalog: deterministic qualification data";
    in-out property <string> invoice-filter-text: "";
    in-out property <bool> clear-scan-after-accept: false;
    in-out property <bool> search-open: false;

    callback search-edited(string);
    callback sales-scan-accepted(string);
    callback choose-item(string);
    callback remove-line(string);
    callback clear-lines();
    callback submit-print();
    callback invoice-filter-edited(string);

    if current-screen == 0 || current-screen == 4: CounterScreen {
        width: 1180px; height: 760px;
        sales-mode: true;
        scroll-offset: current-screen == 4 ? 43px : 0px;
        search-results: root.search-results;
        voucher-lines: root.voucher-lines;
        search-open: root.search-open;
        status-text: root.status-text;
        total-qty-text: root.total-qty-text;
        subtotal-text: root.subtotal-text;
        clear-scan-after-accept <=> root.clear-scan-after-accept;
        navigate(screen) => { current-screen = screen; }
        search-edited(text) => { root.search-edited(text); }
        sales-scan-accepted(text) => { root.sales-scan-accepted(text); }
        choose-item(code) => { root.choose-item(code); }
        remove-line(code) => { root.remove-line(code); }
        clear-lines => { root.clear-lines(); }
        submit-print => { root.submit-print(); }
    }

    if current-screen == 1: CounterScreen {
        width: 1180px; height: 760px;
        sales-mode: false;
        search-results: root.search-results;
        voucher-lines: root.voucher-lines;
        search-open: root.search-open;
        status-text: root.status-text;
        total-qty-text: root.total-qty-text;
        subtotal-text: root.subtotal-text;
        clear-scan-after-accept <=> root.clear-scan-after-accept;
        navigate(screen) => { current-screen = screen; }
        search-edited(text) => { root.search-edited(text); }
        sales-scan-accepted(text) => { root.sales-scan-accepted(text); }
        choose-item(code) => { root.choose-item(code); }
        remove-line(code) => { root.remove-line(code); }
        clear-lines => { root.clear-lines(); }
        submit-print => { root.submit-print(); }
    }

    if current-screen == 2: InvoiceScreen {
        width: 1180px; height: 760px;
        invoice-rows: root.invoice-rows;
        invoice-filter-text <=> root.invoice-filter-text;
        invoice-filter-edited(text) => { root.invoice-filter-edited(text); }
    }

    if current-screen == 3: Rectangle {
        background: Design.bg;
        x: 390px; y: 250px; width: 400px; height: 240px;
        Text { x: 0px; y: 0px; width: 400px; text: root.fixture-note; color: Design.muted; wrap: word-wrap; }
        AboutSlint { x: 0px; y: 120px; width: 180px; height: 80px; }
    }
}
