import {
    AboutSlint,
    Button,
    ComboBox,
    HorizontalBox,
    LineEdit,
    ListView,
    Palette,
    VerticalBox,
} from "std-widgets.slint";

export struct CatalogChoice {
    item-code: string,
    item-name: string,
    uom: string,
    rate-text: string,
    quantity-text: string,
    barcode: string,
}

export struct VoucherLine {
    item-code: string,
    item-name: string,
    qty-text: string,
    uom: string,
    rate-text: string,
    amount-text: string,
}

export struct InvoiceRow {
    name: string,
    customer: string,
    posting-date: string,
    total-text: string,
    status: string,
}

struct Tokens {
    bg: color,
    panel: color,
    text: color,
    muted: color,
    line: color,
    accent: color,
    accent-soft: color,
    focus: color,
    danger: color,
}

global Design {
    out property <Tokens> tokens: {
        bg: #f4f6f8,
        panel: #ffffff,
        text: #17202a,
        muted: #667085,
        line: #d8dee6,
        accent: #146c43,
        accent-soft: #e7f6ee,
        focus: #2e90fa,
        danger: #b42318,
    };
}

component Panel inherits Rectangle {
    in property <string> heading;
    background: Design.tokens.panel;
    border-color: Design.tokens.line;
    border-width: 1px;
    border-radius: 16px;
    clip: true;

    VerticalBox {
        padding: 16px;
        spacing: 10px;
        Text {
            text: root.heading;
            color: Design.tokens.text;
            font-size: 16px;
            font-weight: 700;
        }
        @children
    }
}

component SearchResultRow inherits Rectangle {
    in property <CatalogChoice> item;
    callback chosen(string);
    height: 64px;
    background: touch.has-hover ? Design.tokens.accent-soft : transparent;
    border-radius: 10px;

    touch := TouchArea {
        clicked => { root.chosen(item.item-code); }
    }

    HorizontalBox {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 14px;
        VerticalBox {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: item.item-name;
                color: Design.tokens.text;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: item.item-code + (item.barcode == "" ? "" : "  ·  " + item.barcode);
                color: Design.tokens.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        VerticalBox {
            spacing: 2px;
            Text {
                text: item.rate-text;
                color: Design.tokens.text;
                horizontal-alignment: right;
                font-weight: 700;
            }
            Text {
                text: item.quantity-text + " " + item.uom;
                color: Design.tokens.muted;
                horizontal-alignment: right;
                font-size: 12px;
            }
        }
    }
}

component VoucherLineRow inherits Rectangle {
    in property <VoucherLine> line;
    callback remove(string);
    height: 56px;
    border-radius: 8px;
    background: touch.has-hover ? #f8fafc : transparent;

    touch := TouchArea { }

    HorizontalBox {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalBox {
            horizontal-stretch: 1.5;
            spacing: 1px;
            Text { text: line.item-name; color: Design.tokens.text; font-weight: 650; overflow: elide; }
            Text { text: line.item-code; color: Design.tokens.muted; font-size: 12px; }
        }
        Text { width: 64px; text: line.qty-text; color: Design.tokens.text; horizontal-alignment: right; vertical-alignment: center; }
        Text { width: 64px; text: line.uom; color: Design.tokens.muted; vertical-alignment: center; }
        Text { width: 92px; text: line.rate-text; color: Design.tokens.text; horizontal-alignment: right; vertical-alignment: center; }
        Text { width: 104px; text: line.amount-text; color: Design.tokens.text; horizontal-alignment: right; vertical-alignment: center; font-weight: 700; }
        Button {
            width: 74px;
            text: "Remove";
            clicked => { root.remove(line.item-code); }
        }
    }
}

component InvoiceListRow inherits Rectangle {
    in property <InvoiceRow> invoice;
    height: 46px;
    background: touch.has-hover ? #f8fafc : transparent;
    touch := TouchArea { }

    HorizontalBox {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        Text { width: 180px; text: invoice.name; color: Design.tokens.text; font-weight: 650; overflow: elide; vertical-alignment: center; }
        Text { horizontal-stretch: 1; text: invoice.customer; color: Design.tokens.text; overflow: elide; vertical-alignment: center; }
        Text { width: 110px; text: invoice.posting-date; color: Design.tokens.muted; vertical-alignment: center; }
        Text { width: 120px; text: invoice.total-text; color: Design.tokens.text; horizontal-alignment: right; vertical-alignment: center; }
        Text { width: 90px; text: invoice.status; color: invoice.status == "Paid" ? Design.tokens.accent : Design.tokens.muted; vertical-alignment: center; }
    }
}

component ScreenTab inherits Button {
    in property <bool> active;
    primary: active;
}

export component AppWindow inherits Window {
    title: "Khitmee Native Counter";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 620px;
    background: Design.tokens.bg;

    in property <[CatalogChoice]> search-results: [];
    in property <[VoucherLine]> voucher-lines: [];
    in property <[InvoiceRow]> invoice-rows: [];
    in-out property <string> status-text: "Ready";
    in-out property <string> total-qty-text: "0";
    in-out property <string> subtotal-text: "0.00";
    in-out property <int> current-screen: 0;
    in-out property <string> fixture-note: "Fixture catalog: deterministic qualification data";

    callback search-edited(string);
    callback choose-item(string);
    callback remove-line(string);
    callback clear-lines();
    callback submit-print();
    callback invoice-filter-edited(string);

    forward-focus: key-scope;
    key-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.F2) {
                // F2 focus wiring requires a screen-local public focus function; visual parity evidence must not treat it as complete yet.
                accept
            } else if (event.text == Key.F9) {
                root.submit-print();
                accept
            } else {
                reject
            }
        }
    }

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 74px;
            background: Design.tokens.panel;
            border-color: Design.tokens.line;
            border-width: 1px;

            HorizontalBox {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 20px;
                VerticalBox {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: "KHITMEE OPS";
                        color: Design.tokens.accent;
                        font-size: 12px;
                        font-weight: 800;
                        letter-spacing: 1px;
                    }
                    Text {
                        text: current-screen == 0 ? "Sales Counter" : current-screen == 1 ? "Item Search" : current-screen == 2 ? "Invoice List" : "About";
                        color: Design.tokens.text;
                        font-size: 24px;
                        font-weight: 750;
                    }
                }
                HorizontalBox {
                    spacing: 6px;
                    ScreenTab { text: "Sales"; active: current-screen == 0; clicked => { current-screen = 0; } }
                    ScreenTab { text: "Item Search"; active: current-screen == 1; clicked => { current-screen = 1; } }
                    ScreenTab { text: "Invoices"; active: current-screen == 2; clicked => { current-screen = 2; } }
                    ScreenTab { text: "About"; active: current-screen == 3; clicked => { current-screen = 3; } }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            if current-screen == 0: VerticalBox {
                padding: 16px;
                spacing: 14px;

                HorizontalBox {
                    spacing: 14px;
                    height: 190px;
                    Panel {
                        heading: "Sale details";
                        horizontal-stretch: 0.9;
                        GridLayout {
                            spacing: 10px;
                            Row {
                                Text { text: "Shop warehouse"; color: Design.tokens.muted; vertical-alignment: center; }
                                ComboBox { model: ["Main Shop", "Downtown Counter"]; current-index: 0; }
                            }
                            Row {
                                Text { text: "Customer"; color: Design.tokens.muted; vertical-alignment: center; }
                                ComboBox { model: ["Walking Customer", "Aung Aung", "မြတ်သူ"]; current-index: 0; }
                            }
                            Row {
                                Text { text: "Payment mode"; color: Design.tokens.muted; vertical-alignment: center; }
                                ComboBox { model: ["Cash", "KPay", "Wave Pay"]; current-index: 0; }
                            }
                        }
                    }

                    Panel {
                        heading: "Scan or search";
                        horizontal-stretch: 1.3;
                        item-search := LineEdit {
                            height: 48px;
                            input-type: search;
                            placeholder-text: "Scan barcode or type item name…";
                            edited => { root.search-edited(self.text); }
                            accepted => { root.search-edited(self.text); }
                        }
                        Text {
                            text: "F2 focuses search · exact barcode returns one sellable unit";
                            color: Design.tokens.muted;
                            font-size: 12px;
                        }
                    }
                }

                Panel {
                    heading: "Lines";
                    vertical-stretch: 1;
                    HorizontalBox {
                        Text { horizontal-stretch: 1.5; text: "Item"; color: Design.tokens.muted; font-size: 12px; font-weight: 700; }
                        Text { width: 64px; text: "Qty"; color: Design.tokens.muted; horizontal-alignment: right; font-size: 12px; font-weight: 700; }
                        Text { width: 64px; text: "UOM"; color: Design.tokens.muted; font-size: 12px; font-weight: 700; }
                        Text { width: 92px; text: "Rate"; color: Design.tokens.muted; horizontal-alignment: right; font-size: 12px; font-weight: 700; }
                        Text { width: 104px; text: "Amount"; color: Design.tokens.muted; horizontal-alignment: right; font-size: 12px; font-weight: 700; }
                        Text { width: 74px; text: ""; }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.voucher-lines: VoucherLineRow {
                            line: row;
                            remove(code) => { root.remove-line(code); }
                        }
                    }
                }
            }

            if current-screen == 1: VerticalBox {
                padding: 16px;
                spacing: 14px;
                Panel {
                    heading: "Item search qualification";
                    vertical-stretch: 1;
                    LineEdit {
                        height: 48px;
                        input-type: search;
                        placeholder-text: "Search 10,000 fixture items, Burmese text, or scan barcode…";
                        edited => { root.search-edited(self.text); }
                        accepted => { root.search-edited(self.text); }
                    }
                    Text { text: root.fixture-note; color: Design.tokens.muted; font-size: 12px; }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.search-results: SearchResultRow {
                            item: row;
                            chosen(code) => { root.choose-item(code); }
                        }
                    }
                }
            }

            if current-screen == 2: VerticalBox {
                padding: 16px;
                spacing: 14px;
                Panel {
                    heading: "Invoice list qualification";
                    vertical-stretch: 1;
                    LineEdit {
                        height: 44px;
                        input-type: search;
                        placeholder-text: "Filter invoice number, customer, status…";
                        edited => { root.invoice-filter-edited(self.text); }
                    }
                    HorizontalBox {
                        Text { width: 180px; text: "Invoice"; color: Design.tokens.muted; font-size: 12px; font-weight: 700; }
                        Text { horizontal-stretch: 1; text: "Customer"; color: Design.tokens.muted; font-size: 12px; font-weight: 700; }
                        Text { width: 110px; text: "Date"; color: Design.tokens.muted; font-size: 12px; font-weight: 700; }
                        Text { width: 120px; text: "Total"; color: Design.tokens.muted; horizontal-alignment: right; font-size: 12px; font-weight: 700; }
                        Text { width: 90px; text: "Status"; color: Design.tokens.muted; font-size: 12px; font-weight: 700; }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.invoice-rows: InvoiceListRow { invoice: row; }
                    }
                }
            }

            if current-screen == 3: VerticalBox {
                padding: 22px;
                spacing: 14px;
                Panel {
                    heading: "Native migration pilot";
                    vertical-stretch: 1;
                    Text {
                        text: "Rust + Slint native desktop pilot. ERPNext remains authoritative for financial transactions, inventory mutations, permissions and pricing. Fixture mode is explicitly labelled and is never represented as ERP-verified evidence.";
                        color: Design.tokens.text;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.fixture-note;
                        color: Design.tokens.muted;
                        wrap: word-wrap;
                    }
                    AboutSlint { }
                }
            }
        }

        Rectangle {
            height: 72px;
            background: Design.tokens.panel;
            border-color: Design.tokens.line;
            border-width: 1px;

            HorizontalBox {
                padding-left: 22px;
                padding-right: 22px;
                spacing: 18px;
                Text { text: "Total qty  " + root.total-qty-text; color: Design.tokens.text; font-weight: 700; vertical-alignment: center; }
                Text { text: "Subtotal  " + root.subtotal-text; color: Design.tokens.text; font-weight: 700; vertical-alignment: center; }
                Text { horizontal-stretch: 1; text: root.status-text; color: Design.tokens.muted; vertical-alignment: center; overflow: elide; }
                Button {
                    text: "Clear";
                    clicked => { root.clear-lines(); }
                }
                Button {
                    text: "Submit & Print  F9";
                    primary: true;
                    clicked => { root.submit-print(); }
                }
            }
        }
    }
}
