# Enforce LF line endings on autonomous loop tooling, rules, skills, workflows, and agent instructions.
tools/autoloop/** text eol=lf
.autoloop/** text eol=lf
.devin/skills/autoloop/** text eol=lf
.github/workflows/** text eol=lf
.github/CODEOWNERS text eol=lf
perf-suite/scripts/*.sh text eol=lf
AGENTS.md text eol=lf

# Machine-generated migration fixtures and the Rust lockfile are inputs to
# reproducible verification, not hand-reviewed source. Marking them generated keeps
# Devin Review focused on the implementation.
desktop-frontend/fixtures/** linguist-generated
desktop-frontend/Cargo.lock linguist-generated
