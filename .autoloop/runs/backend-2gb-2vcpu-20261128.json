    "F01-future-sle-repeatable-read-corruption": {
      "finding_id": "F01-future-sle-repeatable-read-corruption",
      "fix_summary": "Prepared master lookups before rollback+lock, captured posting_date/posting_time after lock_stock_coordinates(), and attached re-entrant before_submit locks to all 6 stock doctypes in hooks.py.",
      "opened_at": "2026-11-28T07:13:38Z",
      "resolved_at": "2026-11-28T07:20:49Z",
      "reviewer": "gemini-4-neon-high",
      "safeguard": {
        "artifact": "apps/khitmee_ops/khitmee_ops/api/vouchers.py",
        "layer": "layer_1_architecture",
        "recorded_at": "2026-11-28T07:29:23Z",
        "safeguard_code_tree_sha256": "a95d41ec21b3ef3ae605b0ce70f70a7ec7df0b666fbf96c0ef6fbee663827c3f",
        "summary": "Master prep runs before rollback+lock, timestamps are captured strictly after lock_stock_coordinates(), and re-entrant before_submit locks cover all 6 stock doctypes in hooks.py.",
        "why_not_static": null
      },
      "severity": "P0",
      "stage": "deep",
      "status": "safeguarded",
      "summary": "proven_empty_future_sle_fastpath can read a stale REPEATABLE READ MVCC snapshot opened before lock_stock_coordinates() and capture posting_time before locking; native Desk stock doctypes also lack before_submit stock locks.",
      "verified_at": "2026-11-28T07:29:23Z"
    },
    "F02-voucher-fastpath-multithread-and-lazy-import-crash": {
      "finding_id": "F02-voucher-fastpath-multithread-and-lazy-import-crash",
      "fix_summary": "Replaced global teardown dicts with idempotent closure-bound dispatchers capturing original callables permanently per attribute, eliminating NoneType/RecursionError/lazy-import worker poisoning.",
      "opened_at": "2026-11-28T07:13:38Z",
      "resolved_at": "2026-11-28T07:20:49Z",
      "reviewer": "gemini-4-neon-high",
      "safeguard": {
        "artifact": "apps/khitmee_ops/khitmee_ops/api/voucher_fastpath.py",
        "layer": "layer_1_architecture",
        "recorded_at": "2026-11-28T07:29:23Z",
        "safeguard_code_tree_sha256": "a95d41ec21b3ef3ae605b0ce70f70a7ec7df0b666fbf96c0ef6fbee663827c3f",
        "summary": "Idempotent closure-bound dispatchers permanently capture original callables per attribute, making teardown races, NoneType crashes, RecursionError, and lazy-import poisoning structurally impossible.",
        "why_not_static": null
      },
      "severity": "P0",
      "stage": "deep",
      "status": "safeguarded",
      "summary": "voucher_fastpath.py global dicts cleared on release can poison lazily-imported modules or race with concurrent threads under Gunicorn --threads=12.",
      "verified_at": "2026-11-28T07:29:23Z"
    },
    "F03-perf-parity-oracle-cache-sidecar-permissions": {
      "finding_id": "F03-perf-parity-oracle-cache-sidecar-permissions",
      "fix_summary": "Failed closed when --oracle-cache-dir is combined with --runner exec and added prepare_sidecar_oracle_cache_dir() to ensure UID 1000 sidecar write permissions.",
      "opened_at": "2026-11-28T07:13:38Z",
      "resolved_at": "2026-11-28T07:20:50Z",
      "reviewer": "gemini-4-neon-high",
      "safeguard": {
        "artifact": "tools/perf_parity.py",
        "layer": "layer_1_architecture",
        "recorded_at": "2026-11-28T07:29:23Z",
        "safeguard_code_tree_sha256": "a95d41ec21b3ef3ae605b0ce70f70a7ec7df0b666fbf96c0ef6fbee663827c3f",
        "summary": "host_exec() fails closed when --oracle-cache-dir is combined with --runner exec and prepares UID-1000-writable cache permissions before launching the sidecar.",
        "why_not_static": null
      },
      "severity": "P1",
      "stage": "deep",
      "status": "safeguarded",
      "summary": "tools/perf_parity.py creates --oracle-cache-dir with host umask causing PermissionError in UID 1000 sidecar, and fails to reject --oracle-cache-dir with --runner exec.",
      "verified_at": "2026-11-28T07:29:23Z"
    },
