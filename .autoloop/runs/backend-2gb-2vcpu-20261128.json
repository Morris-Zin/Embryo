    "F07-perf-bench-inner-duplicate-sale-items": {
      "finding_id": "F07-perf-bench-inner-duplicate-sale-items",
      "fix_summary": "Changed build_sale_payload() to use rng.sample() without replacement when pool_len >= line_count so 10/50/200-line benchmark sales have distinct item_codes.",
