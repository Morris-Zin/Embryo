        "safeguard_code_tree_sha256": "a95d41ec21b3ef3ae605b0ce70f70a7ec7df0b666fbf96c0ef6fbee663827c3f",
        "summary": "Unit tests verify _can_fast_sync_autopay_totals() enforces <=1e-9 exact parity on paid, payment, and base totals plus loyalty_amount == 0 before skipping recalculation.",
        "why_not_static": "Floating-point tolerance and multi-field POS accounting invariants depend on runtime document values rather than static AST structure."
      },
      "severity": "P2",
      "stage": "deep",
      "status": "safeguarded",
      "summary": "_can_fast_sync_autopay_totals() allows 0.005 tolerance (5 units at precision=3) and omits loyalty_amount == 0 and base_paid_amount parity checks.",
      "verified_at": "2026-11-28T07:29:23Z"
    },
