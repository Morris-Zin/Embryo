        "safeguard_code_tree_sha256": "a95d41ec21b3ef3ae605b0ce70f70a7ec7df0b666fbf96c0ef6fbee663827c3f",
        "summary": "_run_idempotent() skips rollback and disables future-SLE fastpath whenever transaction_writes > 0, and rollback harnesses use clean transaction rollback instead of fragile SAVEPOINTs.",
        "why_not_static": null
      },
      "severity": "P0",
      "stage": "deep",
      "status": "safeguarded",
      "summary": "Unconditional frappe.db.rollback() in _run_idempotent() destroys MariaDB SAVEPOINTs in perf_parity/perf_bench_inner and can wipe outer uncommitted transaction writes.",
      "verified_at": "2026-11-28T07:29:23Z"
    },
