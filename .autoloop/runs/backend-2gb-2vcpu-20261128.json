        "summary": "Unit tests assert build_sale_payload() samples without replacement so 10/50/200-line sales contain distinct item_codes.",
        "why_not_static": "Random sampling uniqueness is a runtime payload invariant verified by executing build_sale_payload() on fixture pools."
      },
      "severity": "P2",
      "stage": "deep",
      "status": "safeguarded",
      "summary": "build_sale_payload() samples items with replacement, creating duplicate item_codes on 50/200-line sales and silently disabling proven_empty_future_sle_fastpath during inner-loop benchmarks.",
      "verified_at": "2026-11-28T07:29:23Z"
    },
    "F08-happy-path-rollback-breaks-savepoints": {
      "finding_id": "F08-happy-path-rollback-breaks-savepoints",
      "fix_summary": "Guarded _run_idempotent() rollback on transaction_writes == 0 (failing closed on fresh_snapshot=False otherwise) and switched capture_with_rollback()/_profile_rollback_action() to clean transaction rollback without SAVEPOINT 1305 errors.",
      "opened_at": "2026-11-28T07:24:43Z",
      "resolved_at": "2026-11-28T07:27:08Z",
      "reviewer": "gemini-4-neon-high",
      "safeguard": {
